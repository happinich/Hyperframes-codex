.DS_Store
.venv/
.env
.env.*
!.env.example
__pycache__/
*.pyc
node_modules/
tmp/

# Generated audio/video stays local. Commit scripts, timing data, and project
# metadata instead of large or credential-adjacent media binaries.
*.mp3
*.wav
*.flac
*.m4a
*.mp4
*.mov
*.webm

# Local media library files stay local by default.
library/audio/music/*
!library/audio/music/.gitkeep
library/audio/sfx/*
!library/audio/sfx/.gitkeep

# Source recordings and render output stay local by default.
projects/*/02_audio/inbox/*
!projects/*/02_audio/inbox/.gitkeep
projects/*/02_audio/working/*
!projects/*/02_audio/working/.gitkeep
projects/*/04_composition/assets/audio/*
!projects/*/04_composition/assets/audio/.gitkeep
projects/*/04_composition/snapshots/*
projects/*/04_composition/.thumbnails/*
projects/*/05_review/preview/*
!projects/*/05_review/preview/.gitkeep
projects/*/05_review/frames/*
!projects/*/05_review/frames/.gitkeep
projects/*/02_audio/bgm/candidates/*
projects/*/02_audio/bgm/previews/*
projects/*/06_delivery/youtube/*
!projects/*/06_delivery/youtube/.gitkeep
projects/*/06_delivery/shorts/*
!projects/*/06_delivery/shorts/.gitkeep
projects/*/06_delivery/review/*
projects/*/06_delivery/review_frames/*
