{
  "provider": "elevenlabs",
  "endpoint": "POST /v1/text-to-speech/:voice_id",
  "script_source": "../01_script/narration.txt",
  "target_audio": "inbox/2026-007-ai-realtor-growth-narration.mp3",
  "auth": {
    "env_var": "ELEVENLABS_API_KEY",
    "do_not_commit_api_key": true
  },
  "request": {
    "voice_id": "syYMPZoPqpHXYytuWMFR",
    "model_id": "eleven_v3",
    "language_code": "ko",
    "output_format": "mp3_44100_128",
    "voice_settings": {
      "stability": 0.5,
      "similarity_boost": 0.75,
      "style": 0.15,
      "use_speaker_boost": true
    }
  },
  "bgm": {
    "source": "../../../library/audio/music/midnight-library.mp3",
    "gain_db": -18,
    "outro_seconds": 4,
    "outro_gain_db": -14,
    "fade_out_seconds": 3
  }
}
