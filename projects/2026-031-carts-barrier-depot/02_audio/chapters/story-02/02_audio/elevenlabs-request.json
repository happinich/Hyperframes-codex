{
  "provider": "elevenlabs",
  "endpoint": "POST /v1/text-to-speech/:voice_id",
  "script_source": "../01_script/narration.txt",
  "tts_script_source": "../01_script/tts-narration.txt",
  "target_audio": "inbox/story-02-narration.mp3",
  "auth": {
    "env_var": "ELEVENLABS_API_KEY",
    "do_not_commit_api_key": true
  },
  "request": {
    "voice_id": "ZJCNdZEjYwkOElxugmW2",
    "model_id": "eleven_v4",
    "language_code": "ko",
    "apply_text_normalization": "on",
    "output_format": "mp3_44100_128",
    "voice_settings": {
      "stability": 0.5,
      "similarity_boost": 0.75
    },
    "context_stitching": true,
    "performance_direction": "calm, conversational"
  },
  "postprocess": {
    "voice_speed_multiplier": 1.0,
    "automatic_speedup": false,
    "preserve_pitch": true
  },
  "approval_manifest": "../../../../00_brief/script-approval.json",
  "voice_approval": {
    "date_kst": "2026-10-18",
    "user_message": "A · Hyuk (추천)",
    "context": "방음벽·차고지 두 편에 함께 쓸 남성 목소리 선택",
    "scope": [
      "C02_C03_Hyuk",
      "SH02_SH03_Hyuk"
    ]
  },
  "context_stitching_strategy": "prior_request_ids_only; no neighboring chunks after confirmed repeated and corrupted speech in take 01"
}
