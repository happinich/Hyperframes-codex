{
  "provider": "elevenlabs",
  "endpoint": "POST /v1/text-to-speech/:voice_id",
  "script_source": "../01_script/narration.txt",
  "tts_script_source": "../01_script/tts-narration.txt",
  "target_audio": "inbox/story-01-narration.mp3",
  "auth": {
    "env_var": "ELEVENLABS_API_KEY",
    "do_not_commit_api_key": true
  },
  "request": {
    "voice_id": "ah4r1hZOydd3XWlHOm3Y",
    "model_id": "eleven_v4",
    "language_code": "ko",
    "apply_text_normalization": "on",
    "output_format": "mp3_44100_128",
    "voice_settings": {
      "stability": 0.5,
      "similarity_boost": 0.75
    },
    "context_stitching": true,
    "performance_direction": "Natural Korean firsthand storytelling, calm and conversational, gradually tense, restrained emotion, no announcer voice or constant whispering"
  },
  "postprocess": {
    "voice_speed_multiplier": 1.0,
    "automatic_speedup": false,
    "preserve_pitch": true
  },
  "approval_manifest": "../../../../00_brief/script-approval.json",
  "voice_approval": "C01_Jian_K_and_matching_SH01_approved_2026-10-18"
}
