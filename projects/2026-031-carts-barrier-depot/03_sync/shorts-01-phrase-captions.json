[
  {
    "text": "카트 열두 대를 모았는데,",
    "start": 0.0,
    "end": 1.38
  },
  {
    "text": "맨 뒤 바퀴만",
    "start": 1.38,
    "end": 2.8
  },
  {
    "text": "혼자 돌고 있었어요.",
    "start": 2.8,
    "end": 4.26
  },
  {
    "text": "지붕 아래 바닥은 말라 있었는데",
    "start": 4.26,
    "end": 6.08
  },
  {
    "text": "빨간 손잡이에는",
    "start": 6.08,
    "end": 7.52
  },
  {
    "text": "젖은 손가락 자국 네 개가 남았죠.",
    "start": 7.52,
    "end": 10.04
  },
  {
    "text": "저는 사진을 찍고",
    "start": 10.04,
    "end": 11.26
  },
  {
    "text": "카트 안을 확인했습니다.",
    "start": 11.26,
    "end": 13.06
  },
  {
    "text": "짐칸은 비어 있었어요.",
    "start": 13.06,
    "end": 14.82
  },
  {
    "text": "그런데 그 카트와 앞 카트 사이에서",
    "start": 14.82,
    "end": 17.28
  },
  {
    "text": "젖은 운동화 앞코가",
    "start": 17.28,
    "end": 18.88
  },
  {
    "text": "제 쪽으로 돌아갔습니다.",
    "start": 18.88,
    "end": 20.22
  }
]
