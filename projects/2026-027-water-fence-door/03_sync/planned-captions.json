{
  "source": "scene-plan.json",
  "cues": [
    {
      "start": 0.0,
      "end": 2.538,
      "text": "저수조는 비어 있었어요. 그런데 물이 없는"
    },
    {
      "start": 2.538,
      "end": 5.5,
      "text": "바닥에서, 누군가 헤엄치는 소리가 들렸습니다."
    },
    {
      "start": 5.5,
      "end": 8.127,
      "text": "작년 가을에 아파트 관리사무소에서 잠깐"
    },
    {
      "start": 8.127,
      "end": 11.373,
      "text": "일했어요. 정식 직원은 아니었고, 공사 안내문을"
    },
    {
      "start": 11.373,
      "end": 14.309,
      "text": "붙이거나 민원을 정리하는 일이었죠. 그날은"
    },
    {
      "start": 14.309,
      "end": 17.091,
      "text": "저수조 청소 때문에 오전 내내 단수였어요."
    },
    {
      "start": 17.091,
      "end": 20.027,
      "text": "작업팀이 철수한 뒤, 소장님이 지하에 놓고 간"
    },
    {
      "start": 20.027,
      "end": 22.5,
      "text": "서류 봉투를 가져다 달라고 했습니다."
    },
    {
      "start": 22.5,
      "end": 25.728,
      "text": "지하는 처음 가는 곳이었어요. 계단을 내려가면"
    },
    {
      "start": 25.728,
      "end": 28.957,
      "text": "짧은 복도가 있고, 끝의 철문이 저수조 점검실로"
    },
    {
      "start": 28.957,
      "end": 31.862,
      "text": "이어졌죠. 문을 열자 오른쪽 벽에 작업대가"
    },
    {
      "start": 31.862,
      "end": 34.929,
      "text": "보였어요. 봉투도 그 위에 있었고요. 왼쪽은"
    },
    {
      "start": 34.929,
      "end": 37.028,
      "text": "허리 높이 난간 너머로 깊게 파인"
    },
    {
      "start": 37.028,
      "end": 39.933,
      "text": "저수조였습니다. 저는 안으로 내려갈 일이"
    },
    {
      "start": 39.933,
      "end": 43.0,
      "text": "없었어요. 봉투만 챙겨서 나오면 됐거든요."
    },
    {
      "start": 43.0,
      "end": 46.065,
      "text": "봉투를 집으려는데 물을 젓는 소리가 났어요."
    },
    {
      "start": 46.065,
      "end": 49.129,
      "text": "처음에는 청소가 아직 안 끝난 줄 알았죠. 난간"
    },
    {
      "start": 49.129,
      "end": 52.516,
      "text": "가까이 가서 휴대전화 불빛을 비췄습니다. 바닥은"
    },
    {
      "start": 52.516,
      "end": 55.581,
      "text": "드러나 있었어요. 배수구 주변에 물기만 조금"
    },
    {
      "start": 55.581,
      "end": 58.968,
      "text": "남아 있고, 작업하는 사람은 없었습니다. 그런데"
    },
    {
      "start": 58.968,
      "end": 62.032,
      "text": "불빛을 거두자, 바로 아래에서 물장구 소리가"
    },
    {
      "start": 62.032,
      "end": 63.0,
      "text": "다시 났어요."
    },
    {
      "start": 63.0,
      "end": 65.942,
      "text": "소장님께 전화했더니 작업팀은 이미 나갔다고"
    },
    {
      "start": 65.942,
      "end": 69.04,
      "text": "했어요. 배관에서 나는 소리일 수 있으니 봉투만"
    },
    {
      "start": 69.04,
      "end": 71.827,
      "text": "가져오라고 하셨죠. 저도 그 말이 맞겠거니"
    },
    {
      "start": 71.827,
      "end": 74.615,
      "text": "했습니다. 돌아서려는데 이번에는 소리가"
    },
    {
      "start": 74.615,
      "end": 77.867,
      "text": "가까워졌어요. 물이 없는 바닥을 가로질러, 제가"
    },
    {
      "start": 77.867,
      "end": 80.5,
      "text": "서 있는 난간 쪽으로 오는 것 같았습니다."
    },
    {
      "start": 80.5,
      "end": 83.208,
      "text": "난간 바로 아래에는 벽에 고정된 사다리가"
    },
    {
      "start": 83.208,
      "end": 85.916,
      "text": "있었어요. 아까 불빛을 비췄을 때는 말라"
    },
    {
      "start": 85.916,
      "end": 88.783,
      "text": "있었는데, 맨 아래 발판에서 물이 떨어지고"
    },
    {
      "start": 88.783,
      "end": 91.969,
      "text": "있더라고요. 한 방울씩이 아니라 누가 젖은 발을"
    },
    {
      "start": 91.969,
      "end": 94.996,
      "text": "올렸다 뗀 것처럼요. 저는 작업대의 손전등을"
    },
    {
      "start": 94.996,
      "end": 98.5,
      "text": "집었습니다. 휴대전화는 재킷 주머니에 넣었고요."
    },
    {
      "start": 98.5,
      "end": 101.45,
      "text": "손전등으로 사다리를 따라 내려갔어요. 아래쪽 세"
    },
    {
      "start": 101.45,
      "end": 103.839,
      "text": "번째 발판에 검은 것이 걸려 있었습니다."
    },
    {
      "start": 103.839,
      "end": 106.789,
      "text": "처음에는 걸레라고 생각했어요. 길고 가는 실들이"
    },
    {
      "start": 106.789,
      "end": 109.459,
      "text": "발판 아래로 늘어져 있었거든요. 그런데 그게"
    },
    {
      "start": 109.459,
      "end": 112.409,
      "text": "조금씩 위로 당겨졌습니다. 머리카락이었어요."
    },
    {
      "start": 112.409,
      "end": 114.657,
      "text": "발판 뒤에 가려진 머리에서 흘러내리고"
    },
    {
      "start": 114.657,
      "end": 115.5,
      "text": "있었습니다."
    },
    {
      "start": 115.5,
      "end": 118.431,
      "text": "그 순간 전화 진동이 울렸어요. 소장님이었죠."
    },
    {
      "start": 118.431,
      "end": 120.629,
      "text": "화면을 꺼내는 동안 손전등이 옆으로"
    },
    {
      "start": 120.629,
      "end": 123.56,
      "text": "기울었습니다. 소장님은 작업팀이 봉투를 찾고"
    },
    {
      "start": 123.56,
      "end": 126.491,
      "text": "있다며 빨리 올라오라고 했어요. 저는 사다리에"
    },
    {
      "start": 126.491,
      "end": 128.983,
      "text": "사람이 있는 것 같다고 말했습니다. 잠깐"
    },
    {
      "start": 128.983,
      "end": 131.767,
      "text": "조용해지더니, 내려가지 말고 바로 나오라고"
    },
    {
      "start": 131.767,
      "end": 132.5,
      "text": "하셨어요."
    },
    {
      "start": 132.5,
      "end": 135.272,
      "text": "전화를 주머니에 넣고 다시 비췄을 때,"
    },
    {
      "start": 135.272,
      "end": 138.736,
      "text": "머리카락은 두 발판 위에 있었습니다. 그 아래로"
    },
    {
      "start": 138.736,
      "end": 141.854,
      "text": "회색 옷의 어깨가 보였어요. 천은 몸에 붙어"
    },
    {
      "start": 141.854,
      "end": 144.799,
      "text": "있었고, 얼굴은 벽 쪽을 향하고 있었죠."
    },
    {
      "start": 144.799,
      "end": 147.917,
      "text": "사다리를 오르는 사람이라면 등이 제 쪽으로"
    },
    {
      "start": 147.917,
      "end": 150.343,
      "text": "보여야 하는데, 그 어깨는 바닥과"
    },
    {
      "start": 150.343,
      "end": 153.634,
      "text": "나란했습니다. 누군가 누운 채 위로 올라오는"
    },
    {
      "start": 153.634,
      "end": 154.5,
      "text": "것처럼요."
    },
    {
      "start": 154.5,
      "end": 158.04,
      "text": "저는 봉투를 재킷 안쪽에 넣고 철문으로 갔어요."
    },
    {
      "start": 158.04,
      "end": 161.049,
      "text": "들어올 때는 문이 작업대 쪽 벽에 붙을 만큼"
    },
    {
      "start": 161.049,
      "end": 164.588,
      "text": "열려 있었는데, 어느새 반쯤 닫혀 있었습니다."
    },
    {
      "start": 164.588,
      "end": 168.128,
      "text": "문을 당기자 무거운 것이 반대쪽에서 버텼어요."
    },
    {
      "start": 168.128,
      "end": 171.137,
      "text": "문 아래로 물이 흘러들어 왔습니다. 제 쪽"
    },
    {
      "start": 171.137,
      "end": 174.5,
      "text": "바닥은 아직 말라 있었는데, 복도 쪽에서요."
    },
    {
      "start": 174.5,
      "end": 177.508,
      "text": "처음에는 작업자가 밖에 서 있다고 생각했어요."
    },
    {
      "start": 177.508,
      "end": 180.515,
      "text": "비켜 달라고 말했죠. 대답은 없었습니다. 대신"
    },
    {
      "start": 180.515,
      "end": 183.523,
      "text": "문틈으로 손이 들어왔어요. 손바닥을 보여주는"
    },
    {
      "start": 183.523,
      "end": 186.229,
      "text": "모양이 아니라, 손등을 제 쪽으로 향한 채 문"
    },
    {
      "start": 186.229,
      "end": 189.387,
      "text": "가장자리를 감싸 쥐었습니다. 손가락 사이에 검은"
    },
    {
      "start": 189.387,
      "end": 192.395,
      "text": "머리카락이 끼어 있었어요. 방금 사다리에서 본"
    },
    {
      "start": 192.395,
      "end": 194.5,
      "text": "것과 같은 머리카락이었습니다."
    },
    {
      "start": 194.5,
      "end": 197.519,
      "text": "뒤에서는 금속이 긁혔어요. 돌아보니 사다리"
    },
    {
      "start": 197.519,
      "end": 200.857,
      "text": "윗부분이 난간보다 높이 솟아 있었습니다. 벽에서"
    },
    {
      "start": 200.857,
      "end": 203.399,
      "text": "떨어진 사다리가 바닥을 끌며 제 쪽으로"
    },
    {
      "start": 203.399,
      "end": 206.26,
      "text": "기울어지고 있었죠. 회색 옷의 몸은 여전히"
    },
    {
      "start": 206.26,
      "end": 209.12,
      "text": "가로로 누워 있었어요. 머리는 사다리 뒤에"
    },
    {
      "start": 209.12,
      "end": 212.298,
      "text": "가려졌고, 한쪽 팔만 난간 위로 올라왔습니다."
    },
    {
      "start": 212.298,
      "end": 215.0,
      "text": "문을 잡고 있는 손과 똑같은 손이었어요."
    },
    {
      "start": 215.0,
      "end": 218.459,
      "text": "문 안에도 있고, 밖에도 있었습니다. 제가 어느"
    },
    {
      "start": 218.459,
      "end": 221.571,
      "text": "쪽을 보고 있는지 확인하듯, 두 손이 번갈아"
    },
    {
      "start": 221.571,
      "end": 224.684,
      "text": "움직였어요. 밖의 손이 문을 밀면 난간 위의"
    },
    {
      "start": 224.684,
      "end": 227.797,
      "text": "손이 아래로 사라졌고, 문을 조금 당기면 그"
    },
    {
      "start": 227.797,
      "end": 230.737,
      "text": "손이 다시 올라왔습니다. 그때 처음으로"
    },
    {
      "start": 230.737,
      "end": 233.677,
      "text": "말소리가 났어요. 물에 잠긴 입으로 하는"
    },
    {
      "start": 233.677,
      "end": 237.135,
      "text": "말처럼, 중간중간 공기가 끓었습니다. 아직 못"
    },
    {
      "start": 237.135,
      "end": 238.0,
      "text": "올라갔어."
    },
    {
      "start": 238.0,
      "end": 240.769,
      "text": "저는 문손잡이를 두 손으로 잡아당겼어요."
    },
    {
      "start": 240.769,
      "end": 243.692,
      "text": "손전등은 겨드랑이에 끼웠고요. 문이 손가락"
    },
    {
      "start": 243.692,
      "end": 246.923,
      "text": "너비만큼 벌어졌다가 다시 닫혔습니다. 손잡이가"
    },
    {
      "start": 246.923,
      "end": 249.538,
      "text": "아래로 휘는 게 보였어요. 그 손이 제 힘을"
    },
    {
      "start": 249.538,
      "end": 252.308,
      "text": "받아내는 동안, 문 밖의 물은 제 신발 밑까지"
    },
    {
      "start": 252.308,
      "end": 255.692,
      "text": "넘어왔습니다. 차가웠어요. 바닥을 적시는 물인데"
    },
    {
      "start": 255.692,
      "end": 258.0,
      "text": "발목까지 잠긴 느낌이 들었습니다."
    },
    {
      "start": 258.0,
      "end": 261.254,
      "text": "등 뒤에서 사다리가 난간에 부딪쳤어요. 놀라서"
    },
    {
      "start": 261.254,
      "end": 264.671,
      "text": "팔을 들었고, 손전등이 떨어졌습니다. 바닥에서"
    },
    {
      "start": 264.671,
      "end": 267.762,
      "text": "한 번 튄 뒤 저수조 안으로 굴러갔어요. 불빛이"
    },
    {
      "start": 267.762,
      "end": 270.69,
      "text": "사다리 아래를 훑는 순간, 문을 누르던 힘이"
    },
    {
      "start": 270.69,
      "end": 273.456,
      "text": "잠깐 풀렸습니다. 밖의 손가락이 문에서"
    },
    {
      "start": 273.456,
      "end": 276.71,
      "text": "떨어졌고요. 저는 이유를 생각할 틈도 없이 문을"
    },
    {
      "start": 276.71,
      "end": 278.5,
      "text": "열고 복도로 나왔습니다."
    },
    {
      "start": 278.5,
      "end": 280.919,
      "text": "계단까지 몇 걸음 안 됐는데 너무 멀게"
    },
    {
      "start": 280.919,
      "end": 283.984,
      "text": "느껴졌어요. 뒤에서 철문이 닫히고, 물장구"
    },
    {
      "start": 283.984,
      "end": 287.371,
      "text": "소리가 따라왔습니다. 발소리도 아니고 물을 쏟는"
    },
    {
      "start": 287.371,
      "end": 290.435,
      "text": "소리도 아니었어요. 누가 제 바로 뒤에서 팔을"
    },
    {
      "start": 290.435,
      "end": 293.661,
      "text": "크게 저으며 헤엄치고 있었습니다. 저는 계단을"
    },
    {
      "start": 293.661,
      "end": 296.887,
      "text": "올라가면서 봉투를 놓쳤습니다. 내려가서 주울"
    },
    {
      "start": 296.887,
      "end": 298.5,
      "text": "생각은 전혀 못 했어요."
    },
    {
      "start": 298.5,
      "end": 301.62,
      "text": "소장님은 제 얼굴을 보자 다른 직원에게 지하로"
    },
    {
      "start": 301.62,
      "end": 304.741,
      "text": "같이 가 달라고 했습니다. 저는 관리사무소에"
    },
    {
      "start": 304.741,
      "end": 307.697,
      "text": "남았어요. 얼마 뒤 두 분이 봉투와 손전등을"
    },
    {
      "start": 307.697,
      "end": 311.146,
      "text": "가져왔죠. 봉투는 계단 중간에 있었고, 손전등은"
    },
    {
      "start": 311.146,
      "end": 314.595,
      "text": "저수조 바닥에 떨어져 있었다고 했어요. 사다리는"
    },
    {
      "start": 314.595,
      "end": 317.88,
      "text": "원래 자리였고, 문손잡이도 휘지 않았다고요."
    },
    {
      "start": 317.88,
      "end": 321.0,
      "text": "그런데 두 분 모두 신발 밑이 젖어 있었습니다."
    },
    {
      "start": 321.0,
      "end": 323.93,
      "text": "소장님은 청소하고 남은 물일 거라고 했어요."
    },
    {
      "start": 323.93,
      "end": 326.86,
      "text": "제가 무슨 말을 하든 그 얘기만 반복했습니다."
    },
    {
      "start": 326.86,
      "end": 329.79,
      "text": "저는 그날 이후 지하 심부름을 하지 않았어요."
    },
    {
      "start": 329.79,
      "end": 332.565,
      "text": "계약이 끝날 때까지 관리사무소에서 서류만"
    },
    {
      "start": 332.565,
      "end": 335.65,
      "text": "정리했습니다. 손전등을 가져다 놓으라는 말도"
    },
    {
      "start": 335.65,
      "end": 337.5,
      "text": "다른 직원에게 부탁했고요."
    },
    {
      "start": 337.5,
      "end": 340.356,
      "text": "마지막 날, 서류함에서 그날 작업 사진을"
    },
    {
      "start": 340.356,
      "end": 343.212,
      "text": "봤어요. 청소가 끝난 저수조 바닥을 찍은"
    },
    {
      "start": 343.212,
      "end": 346.236,
      "text": "사진이었습니다. 사다리는 말라 있었고,"
    },
    {
      "start": 346.236,
      "end": 349.428,
      "text": "아래에는 아무도 없었죠. 그런데 사진 오른쪽"
    },
    {
      "start": 349.428,
      "end": 352.62,
      "text": "끝에 철문이 조금 찍혀 있었습니다. 문은 열려"
    },
    {
      "start": 352.62,
      "end": 355.644,
      "text": "있었어요. 그 아래, 복도 쪽에서 회색 옷의"
    },
    {
      "start": 355.644,
      "end": 358.5,
      "text": "젖은 팔 하나가 문을 붙들고 있었습니다."
    },
    {
      "start": 358.5,
      "end": 361.59,
      "text": "사진 파일의 시간을 두 번 확인했어요. 제가"
    },
    {
      "start": 361.59,
      "end": 365.022,
      "text": "지하에 내려가기 한 시간 전이었습니다. 그때도"
    },
    {
      "start": 365.022,
      "end": 368.455,
      "text": "문을 잡고 있었던 거예요. 누군가 들어오면 닫을"
    },
    {
      "start": 368.455,
      "end": 371.373,
      "text": "수 있도록요. 저는 사진을 다시 서류함에"
    },
    {
      "start": 371.373,
      "end": 374.634,
      "text": "넣었습니다. 그날 점심에 소장님이 저수조에"
    },
    {
      "start": 374.634,
      "end": 377.724,
      "text": "물을 다시 채웠다고 했을 때, 제가 왜 그렇게"
    },
    {
      "start": 377.724,
      "end": 380.47,
      "text": "오래 대답을 못 했는지는 끝내 설명하지"
    },
    {
      "start": 380.47,
      "end": 381.5,
      "text": "않았습니다."
    },
    {
      "start": 386.5,
      "end": 389.735,
      "text": "울타리가 높아서 안심했어요. 철망 밖에 서 있던"
    },
    {
      "start": 389.735,
      "end": 392.0,
      "text": "그것이, 몸을 접기 전까지는요."
    },
    {
      "start": 392.0,
      "end": 394.543,
      "text": "평일에 연차를 내고 혼자 캠핑을 간 적이"
    },
    {
      "start": 394.543,
      "end": 397.562,
      "text": "있어요. 산 아래 작은 캠핑장이었는데, 차를"
    },
    {
      "start": 397.562,
      "end": 400.422,
      "text": "텐트 바로 옆에 세울 수 있어서 골랐죠. 제가"
    },
    {
      "start": 400.422,
      "end": 403.601,
      "text": "예약한 자리는 가장 안쪽이었습니다. 왼쪽에는"
    },
    {
      "start": 403.601,
      "end": 406.62,
      "text": "철망 울타리가 있었고, 오른쪽으로 난 차로를"
    },
    {
      "start": 406.62,
      "end": 409.957,
      "text": "따라가면 관리실과 출입구가 나왔어요. 평일이라"
    },
    {
      "start": 409.957,
      "end": 412.5,
      "text": "가까운 자리에는 아무도 없었습니다."
    },
    {
      "start": 412.5,
      "end": 415.371,
      "text": "저녁을 먹고 설거지를 하러 갔어요. 관리실"
    },
    {
      "start": 415.371,
      "end": 418.241,
      "text": "앞에는 주인 차가 있었고, 안에서 텔레비전"
    },
    {
      "start": 418.241,
      "end": 421.272,
      "text": "소리도 났죠. 주인분은 밤에 산 쪽에서 짐승이"
    },
    {
      "start": 421.272,
      "end": 423.983,
      "text": "내려올 때가 있으니 음식은 차에 넣으라고"
    },
    {
      "start": 423.983,
      "end": 427.013,
      "text": "했습니다. 저는 남은 고기를 밀폐용기에 담아"
    },
    {
      "start": 427.013,
      "end": 430.203,
      "text": "트렁크에 넣었어요. 쓰레기도 정해진 수거함에"
    },
    {
      "start": 430.203,
      "end": 431.0,
      "text": "버렸고요."
    },
    {
      "start": 431.0,
      "end": 434.268,
      "text": "자리로 돌아오는데 울타리 밖에서 풀이 눌리는"
    },
    {
      "start": 434.268,
      "end": 437.364,
      "text": "소리가 들렸어요. 랜턴을 들어 봤지만 나무"
    },
    {
      "start": 437.364,
      "end": 440.46,
      "text": "사이가 어두워 잘 안 보였습니다. 고라니일"
    },
    {
      "start": 440.46,
      "end": 443.728,
      "text": "거라고 생각했죠. 텐트 앞 의자에 앉았는데,"
    },
    {
      "start": 443.728,
      "end": 446.824,
      "text": "이번에는 제가 앉는 소리에 맞춰 풀을 누르는"
    },
    {
      "start": 446.824,
      "end": 449.748,
      "text": "소리가 났어요. 한 번만 그런 게 아니라,"
    },
    {
      "start": 449.748,
      "end": 452.5,
      "text": "자세를 바꿀 때마다 같은 간격으로요."
    },
    {
      "start": 452.5,
      "end": 455.264,
      "text": "손뼉을 쳐 봤어요. 짐승이면 달아날 줄"
    },
    {
      "start": 455.264,
      "end": 458.718,
      "text": "알았거든요. 소리가 잠깐 멈췄습니다. 그러다"
    },
    {
      "start": 458.718,
      "end": 462.173,
      "text": "울타리 바깥에서 손뼉 소리가 났어요. 아주 작고"
    },
    {
      "start": 462.173,
      "end": 465.455,
      "text": "축축한 소리였어요. 저는 누가 장난을 치는 줄"
    },
    {
      "start": 465.455,
      "end": 468.909,
      "text": "알았습니다. 거기 사람 있냐고 물었는데, 대답"
    },
    {
      "start": 468.909,
      "end": 471.5,
      "text": "대신 손뼉 소리가 한 번 더 들렸어요."
    },
    {
      "start": 471.5,
      "end": 474.525,
      "text": "그제야 차 키를 손에 쥐었습니다. 차는 텐트"
    },
    {
      "start": 474.525,
      "end": 477.55,
      "text": "오른쪽에 있었고, 운전석은 차로를 향하고"
    },
    {
      "start": 477.55,
      "end": 480.912,
      "text": "있었어요. 두어 걸음이면 탈 수 있었죠. 랜턴을"
    },
    {
      "start": 480.912,
      "end": 483.769,
      "text": "텐트 앞 고리에 걸고 휴대전화로 관리실에"
    },
    {
      "start": 483.769,
      "end": 487.13,
      "text": "전화했습니다. 연결음이 가는 동안 울타리 밖을"
    },
    {
      "start": 487.13,
      "end": 489.987,
      "text": "봤어요. 철망 위쪽에 검은 머리 같은 것이"
    },
    {
      "start": 489.987,
      "end": 491.5,
      "text": "올라와 있었습니다."
    },
    {
      "start": 491.5,
      "end": 494.507,
      "text": "관리실은 전화를 받지 않았어요. 저는 주인분이"
    },
    {
      "start": 494.507,
      "end": 497.364,
      "text": "화장실에 갔나 싶어서 문자부터 보냈습니다."
    },
    {
      "start": 497.364,
      "end": 500.22,
      "text": "울타리 밖에 누가 있다고요. 휴대전화는 재킷"
    },
    {
      "start": 500.22,
      "end": 503.227,
      "text": "주머니에 넣었습니다. 다시 고개를 들었을 때 그"
    },
    {
      "start": 503.227,
      "end": 506.084,
      "text": "머리는 낮아져 있었습니다. 어깨 같은 부분이"
    },
    {
      "start": 506.084,
      "end": 508.941,
      "text": "철망 가운데 높이에 있었어요. 그런데 무릎을"
    },
    {
      "start": 508.941,
      "end": 511.797,
      "text": "굽히는 모습이 아니었습니다. 몸통이 옆으로"
    },
    {
      "start": 511.797,
      "end": 513.0,
      "text": "접히고 있었어요."
    },
    {
      "start": 513.0,
      "end": 516.05,
      "text": "철망 너머에는 팔인지 다리인지 모를 긴 것이"
    },
    {
      "start": 516.05,
      "end": 519.099,
      "text": "보였습니다. 중간에 꺾이는 부분이 하나 더"
    },
    {
      "start": 519.099,
      "end": 522.318,
      "text": "있었죠. 그게 나무에 가려졌다가 다시 나타날"
    },
    {
      "start": 522.318,
      "end": 525.368,
      "text": "때마다, 머리는 같은 높이에 있는데 몸은 더"
    },
    {
      "start": 525.368,
      "end": 528.587,
      "text": "길게 늘어났어요. 사람의 자세로 설명할 수가"
    },
    {
      "start": 528.587,
      "end": 531.806,
      "text": "없었습니다. 저는 의자에서 일어나지 못한 채"
    },
    {
      "start": 531.806,
      "end": 533.5,
      "text": "그것만 보고 있었어요."
    },
    {
      "start": 533.5,
      "end": 536.782,
      "text": "그때 차 경보음이 짧게 울렸습니다. 제가 키를"
    },
    {
      "start": 536.782,
      "end": 540.236,
      "text": "너무 세게 쥐어서 버튼을 눌렀던 거예요. 울타리"
    },
    {
      "start": 540.236,
      "end": 543.173,
      "text": "밖의 머리가 차 쪽으로 돌아갔어요. 목은"
    },
    {
      "start": 543.173,
      "end": 546.455,
      "text": "움직이지 않았습니다. 머리 아래의 접힌 몸이"
    },
    {
      "start": 546.455,
      "end": 549.736,
      "text": "통째로 방향을 바꿨죠. 저는 다시 버튼을 눌러"
    },
    {
      "start": 549.736,
      "end": 552.5,
      "text": "차 문을 열고, 운전석으로 갔습니다."
    },
    {
      "start": 552.5,
      "end": 555.788,
      "text": "문을 여는데 등 뒤에서 철망이 울렸어요. 얼른"
    },
    {
      "start": 555.788,
      "end": 559.077,
      "text": "타고 문을 닫았습니다. 시동을 걸려는데 키가"
    },
    {
      "start": 559.077,
      "end": 562.192,
      "text": "바닥으로 떨어졌어요. 몸을 숙여 주우면서"
    },
    {
      "start": 562.192,
      "end": 565.135,
      "text": "왼쪽을 봤습니다. 차 옆 창 너머로 텐트 앞"
    },
    {
      "start": 565.135,
      "end": 568.423,
      "text": "랜턴이 보였어요. 그 뒤, 울타리 밑의 틈으로"
    },
    {
      "start": 568.423,
      "end": 571.712,
      "text": "검은 것이 밀려 들어오고 있었습니다. 머리가"
    },
    {
      "start": 571.712,
      "end": 575.0,
      "text": "먼저였고, 몸이 여러 번 접혀서 따라왔어요."
    },
    {
      "start": 575.0,
      "end": 577.347,
      "text": "틈은 사람 어깨가 지나갈 만한 높이가"
    },
    {
      "start": 577.347,
      "end": 580.634,
      "text": "아니었어요. 그런데 몸이 납작해지거나 사라지는"
    },
    {
      "start": 580.634,
      "end": 583.763,
      "text": "건 아니었습니다. 긴 몸통이 지그재그로 접힌 채"
    },
    {
      "start": 583.763,
      "end": 587.05,
      "text": "철망 밑을 통과했어요. 마지막에 딸려온 팔다리가"
    },
    {
      "start": 587.05,
      "end": 589.866,
      "text": "풀밭을 짚자, 제가 의자에서 듣던 그 소리가"
    },
    {
      "start": 589.866,
      "end": 592.84,
      "text": "났습니다. 축축한 손뼉 소리요. 그건 손뼉이"
    },
    {
      "start": 592.84,
      "end": 595.5,
      "text": "아니었어요. 땅을 짚는 소리였습니다."
    },
    {
      "start": 595.5,
      "end": 598.358,
      "text": "시동을 걸었습니다. 불이 들어오면서 차로가"
    },
    {
      "start": 598.358,
      "end": 601.366,
      "text": "보였어요. 앞으로 가면 관리실이었죠. 그런데"
    },
    {
      "start": 601.366,
      "end": 604.374,
      "text": "텐트 한쪽이 차 쪽으로 넘어왔습니다. 지지대가"
    },
    {
      "start": 604.374,
      "end": 606.931,
      "text": "천 안에서 꺾이고 있었어요. 랜턴도 함께"
    },
    {
      "start": 606.931,
      "end": 609.939,
      "text": "흔들렸고요. 그 아래에서 긴 팔다리 하나가 텐트"
    },
    {
      "start": 609.939,
      "end": 612.496,
      "text": "바닥을 누르고 있었습니다. 천 위로 굽은"
    },
    {
      "start": 612.496,
      "end": 614.0,
      "text": "마디들이 드러났어요."
    },
    {
      "start": 614.0,
      "end": 617.263,
      "text": "텐트 천이 옆 창에 닿았습니다. 차를 움직이면"
    },
    {
      "start": 617.263,
      "end": 620.698,
      "text": "끌려올 것 같았지만 그대로 있을 수는 없었어요."
    },
    {
      "start": 620.698,
      "end": 624.134,
      "text": "저는 천천히 앞으로 갔습니다. 접힌 지지대가 차"
    },
    {
      "start": 624.134,
      "end": 627.569,
      "text": "뒤쪽을 긁었고, 텐트가 바퀴에서 떨어졌어요."
    },
    {
      "start": 627.569,
      "end": 630.832,
      "text": "그 순간 왼쪽 사이드미러에 몸이 비쳤습니다."
    },
    {
      "start": 630.832,
      "end": 633.752,
      "text": "숲에서 높게 서 있던 그것이, 이제 차 창문"
    },
    {
      "start": 633.752,
      "end": 636.5,
      "text": "아래로 몸을 접고 따라오고 있었어요."
    },
    {
      "start": 636.5,
      "end": 639.23,
      "text": "속도를 올리려고 하는데 차가 한 번 크게"
    },
    {
      "start": 639.23,
      "end": 642.643,
      "text": "흔들렸습니다. 왼쪽 뒤에서 금속이 찌그러지는"
    },
    {
      "start": 642.643,
      "end": 645.885,
      "text": "소리가 났어요. 거울로 보니 긴 팔다리가 뒷문"
    },
    {
      "start": 645.885,
      "end": 649.127,
      "text": "위를 누르고 있었습니다. 손처럼 뭔가를 쥐는"
    },
    {
      "start": 649.127,
      "end": 652.54,
      "text": "끝은 없었어요. 마디가 하나 더 꺾이면서 차체를"
    },
    {
      "start": 652.54,
      "end": 655.782,
      "text": "감싸고 있었죠. 저는 차로 오른쪽의 빈 자리를"
    },
    {
      "start": 655.782,
      "end": 658.0,
      "text": "돌아 크게 방향을 틀었습니다."
    },
    {
      "start": 658.0,
      "end": 661.5,
      "text": "마디가 미끄러지듯 떨어졌고 차가 곧게 나갔어요."
    },
    {
      "start": 661.5,
      "end": 665.0,
      "text": "관리실 앞까지 와서 경적을 눌렀습니다. 주인분이"
    },
    {
      "start": 665.0,
      "end": 668.0,
      "text": "문을 열고 나왔죠. 저는 창문을 조금 내려서"
    },
    {
      "start": 668.0,
      "end": 671.333,
      "text": "뒤에 뭐가 있다고 말했어요. 그런데 끝까지 말을"
    },
    {
      "start": 671.333,
      "end": 674.5,
      "text": "못 했습니다. 주인분 어깨 너머로, 제가 있던"
    },
    {
      "start": 674.5,
      "end": 677.833,
      "text": "자리의 랜턴이 아직 보였거든요. 그 아래에 아주"
    },
    {
      "start": 677.833,
      "end": 680.5,
      "text": "길고 낮은 형상이 엎드려 있었습니다."
    },
    {
      "start": 680.5,
      "end": 683.607,
      "text": "주인분은 차에서 내리지 말라고 했어요. 자기"
    },
    {
      "start": 683.607,
      "end": 686.715,
      "text": "차를 타고 앞장설 테니 따라오라고요. 캠핑장"
    },
    {
      "start": 686.715,
      "end": 689.822,
      "text": "출입구를 지나 큰길에 나올 때까지 저는 거울을"
    },
    {
      "start": 689.822,
      "end": 692.603,
      "text": "제대로 보지 못했습니다. 뒤를 보면 다시"
    },
    {
      "start": 692.603,
      "end": 695.547,
      "text": "가까워질 것 같았어요. 큰길 편의점에 멈춘"
    },
    {
      "start": 695.547,
      "end": 698.0,
      "text": "뒤에야 내려서 차를 확인했습니다."
    },
    {
      "start": 698.0,
      "end": 701.291,
      "text": "왼쪽 뒷문 위에 길게 눌린 자국이 있었습니다."
    },
    {
      "start": 701.291,
      "end": 704.409,
      "text": "나뭇가지에 긁힌 자국이 아니라, 넓은 것이"
    },
    {
      "start": 704.409,
      "end": 707.874,
      "text": "위에서 누른 모양이었어요. 그 아래에는 마디 두"
    },
    {
      "start": 707.874,
      "end": 710.472,
      "text": "개가 연달아 닿은 듯한 둥근 홈이 남아"
    },
    {
      "start": 710.472,
      "end": 713.764,
      "text": "있었고요. 주인분은 제가 괜찮은지 묻더니,"
    },
    {
      "start": 713.764,
      "end": 716.709,
      "text": "텐트와 짐은 다음 날 택배로 보내 주겠다고"
    },
    {
      "start": 716.709,
      "end": 720.0,
      "text": "했습니다. 무엇을 봤는지는 묻지 않았어요."
    },
    {
      "start": 720.0,
      "end": 723.093,
      "text": "다음 날 관리실에서 전화가 왔습니다. 텐트는"
    },
    {
      "start": 723.093,
      "end": 726.023,
      "text": "찢어져서 못 쓰겠지만 다른 물건은 챙겼다고"
    },
    {
      "start": 726.023,
      "end": 728.628,
      "text": "했어요. 저는 울타리 밖에 있던 게 뭔지"
    },
    {
      "start": 728.628,
      "end": 731.721,
      "text": "물었습니다. 주인분은 한참 말이 없었어요."
    },
    {
      "start": 731.721,
      "end": 734.977,
      "text": "그러더니 야생동물일 수도 있다고 했죠. 그 말을"
    },
    {
      "start": 734.977,
      "end": 738.07,
      "text": "믿고 싶었지만, 짐승이 철망보다 높았다가 차"
    },
    {
      "start": 738.07,
      "end": 741.0,
      "text": "창문보다 낮아지는 모습을 저는 봤습니다."
    },
    {
      "start": 741.0,
      "end": 743.929,
      "text": "며칠 뒤 택배 상자에서 의자를 꺼냈어요."
    },
    {
      "start": 743.929,
      "end": 747.374,
      "text": "의자에는 흙이 거의 안 묻어 있었습니다. 접어서"
    },
    {
      "start": 747.374,
      "end": 750.819,
      "text": "넣어 준 담요도 멀쩡했고요. 그런데 랜턴은 고리"
    },
    {
      "start": 750.819,
      "end": 754.092,
      "text": "부분이 바깥으로 길게 펴져 있었어요. 텐트에"
    },
    {
      "start": 754.092,
      "end": 757.538,
      "text": "걸려 있던 고리가, 누군가 잡아당긴 것처럼요."
    },
    {
      "start": 757.538,
      "end": 760.811,
      "text": "제가 차로 떠난 뒤에도 그 불빛 가까이에 있었던"
    },
    {
      "start": 760.811,
      "end": 761.5,
      "text": "겁니다."
    },
    {
      "start": 761.5,
      "end": 764.559,
      "text": "그때 주인분이 보낸 사진을 다시 봤어요. 짐을"
    },
    {
      "start": 764.559,
      "end": 767.78,
      "text": "챙겼다는 문자에 붙어 있던 사진이었죠. 무너진"
    },
    {
      "start": 767.78,
      "end": 771.0,
      "text": "텐트와 울타리가 보였습니다. 철망 밑의 틈에는"
    },
    {
      "start": 771.0,
      "end": 773.898,
      "text": "흙이 밀린 자국이 남아 있었어요. 들어올 때"
    },
    {
      "start": 773.898,
      "end": 776.958,
      "text": "생긴 긴 자국 하나뿐이었습니다. 저는 화면을"
    },
    {
      "start": 776.958,
      "end": 779.534,
      "text": "확대했다가 바로 껐어요. 나간 자국은"
    },
    {
      "start": 779.534,
      "end": 780.5,
      "text": "없었습니다."
    },
    {
      "start": 785.5,
      "end": 788.833,
      "text": "문 뒤에는 벽이 있어야 했어요. 그런데 안쪽에서"
    },
    {
      "start": 788.833,
      "end": 790.5,
      "text": "누가 문을 잠갔습니다."
    },
    {
      "start": 790.5,
      "end": 793.406,
      "text": "이사하던 날, 짐 정리가 늦게 끝났어요."
    },
    {
      "start": 793.406,
      "end": 796.654,
      "text": "기사님들이 돌아간 뒤 현관 옆에 낡은 문 하나가"
    },
    {
      "start": 796.654,
      "end": 799.902,
      "text": "남아 있었습니다. 밝은 갈색 나무문이었는데"
    },
    {
      "start": 799.902,
      "end": 803.321,
      "text": "아래쪽에 검은 얼룩이 있었죠. 손잡이와 경첩도"
    },
    {
      "start": 803.321,
      "end": 806.91,
      "text": "붙어 있었고요. 저는 집주인이 교체하려고 가져다"
    },
    {
      "start": 806.91,
      "end": 809.645,
      "text": "놓은 문인 줄 알고 거실 안쪽 벽에 기대어"
    },
    {
      "start": 809.645,
      "end": 810.5,
      "text": "뒀습니다."
    },
    {
      "start": 810.5,
      "end": 814.048,
      "text": "새 집은 구조가 단순했어요. 현관에서 들어오면"
    },
    {
      "start": 814.048,
      "end": 817.065,
      "text": "거실, 왼쪽에 주방, 오른쪽에 방 하나가"
    },
    {
      "start": 817.065,
      "end": 820.435,
      "text": "있었습니다. 문을 세워 둔 곳은 거실 끝의 막힌"
    },
    {
      "start": 820.435,
      "end": 823.452,
      "text": "벽이었어요. 그 뒤는 옆집도 아니고 건물"
    },
    {
      "start": 823.452,
      "end": 827.0,
      "text": "바깥쪽이었죠. 커튼을 달고 옷을 정리하다 보니"
    },
    {
      "start": 827.0,
      "end": 830.548,
      "text": "어느새 밤이 됐습니다. 저는 바닥에 매트를 펴고"
    },
    {
      "start": 830.548,
      "end": 832.5,
      "text": "물 한 잔을 가지러 갔어요."
    },
    {
      "start": 832.5,
      "end": 836.02,
      "text": "주방에 서 있는데 뒤에서 손잡이를 돌리는 소리가"
    },
    {
      "start": 836.02,
      "end": 839.364,
      "text": "났어요. 방 문이 덜 닫혔나 싶어서 돌아봤죠."
    },
    {
      "start": 839.364,
      "end": 842.708,
      "text": "방문은 열려 있었습니다. 소리가 난 쪽은 거실"
    },
    {
      "start": 842.708,
      "end": 846.228,
      "text": "끝이었어요. 세워 둔 나무문의 손잡이가 아래로"
    },
    {
      "start": 846.228,
      "end": 849.572,
      "text": "내려가 있었습니다. 저는 기울어진 문이 벽에"
    },
    {
      "start": 849.572,
      "end": 852.916,
      "text": "눌렸나 싶어 조금 당겼어요. 그 뒤에 있어야 할"
    },
    {
      "start": 852.916,
      "end": 854.5,
      "text": "벽이 안 보였습니다."
    },
    {
      "start": 854.5,
      "end": 857.411,
      "text": "문 뒤가 검게 비어 있었어요. 제 손바닥 하나가"
    },
    {
      "start": 857.411,
      "end": 860.169,
      "text": "들어갈 만큼 벌어진 틈 너머로 바닥이 이어져"
    },
    {
      "start": 860.169,
      "end": 863.081,
      "text": "있었습니다. 저는 손을 놓았습니다. 문이 벽"
    },
    {
      "start": 863.081,
      "end": 866.452,
      "text": "쪽으로 돌아가면서 손잡이가 올라왔어요. 그다음,"
    },
    {
      "start": 866.452,
      "end": 869.516,
      "text": "안쪽에서 잠금쇠가 돌아갔습니다. 누군가 문을"
    },
    {
      "start": 869.516,
      "end": 872.427,
      "text": "닫고 잠근 소리였어요. 저는 그제야 현관으로"
    },
    {
      "start": 872.427,
      "end": 873.5,
      "text": "물러났습니다."
    },
    {
      "start": 873.5,
      "end": 876.416,
      "text": "이사업체에 전화했어요. 그 문은 제 짐이"
    },
    {
      "start": 876.416,
      "end": 879.675,
      "text": "아니라고 했죠. 담당자는 사진을 보내 달라고"
    },
    {
      "start": 879.675,
      "end": 882.591,
      "text": "했습니다. 문을 찍어 보내자 바로 전화가"
    },
    {
      "start": 882.591,
      "end": 885.85,
      "text": "왔어요. 다른 집에서 나온 물건이 잘못 실린 것"
    },
    {
      "start": 885.85,
      "end": 889.109,
      "text": "같다고요. 내일 아침에 수거할 테니 건드리지"
    },
    {
      "start": 889.109,
      "end": 892.369,
      "text": "말고 바닥에 눕혀 두라고 했습니다. 왜 눕혀야"
    },
    {
      "start": 892.369,
      "end": 895.456,
      "text": "하냐고 물었는데, 넘어지면 다칠 수 있다는"
    },
    {
      "start": 895.456,
      "end": 897.0,
      "text": "대답만 돌아왔어요."
    },
    {
      "start": 897.0,
      "end": 900.062,
      "text": "저는 이미 벽에 세웠다고 했습니다. 담당자가"
    },
    {
      "start": 900.062,
      "end": 902.963,
      "text": "잠깐 말을 멈췄어요. 그러더니 경첩이 위를"
    },
    {
      "start": 902.963,
      "end": 905.864,
      "text": "향하게 눕혀 달라고 했죠. 문이 열려 있으면"
    },
    {
      "start": 905.864,
      "end": 908.926,
      "text": "먼저 닫고요. 그 말이 이상했습니다. 문틀도"
    },
    {
      "start": 908.926,
      "end": 912.149,
      "text": "없는 문인데, 열려 있으면 닫으라니요. 그래도"
    },
    {
      "start": 912.149,
      "end": 915.211,
      "text": "누구라도 구체적으로 말해 주니까 시키는 대로"
    },
    {
      "start": 915.211,
      "end": 916.5,
      "text": "하고 싶었습니다."
    },
    {
      "start": 916.5,
      "end": 919.508,
      "text": "문 위쪽을 잡고 앞으로 당겼어요. 무거웠지만"
    },
    {
      "start": 919.508,
      "end": 922.517,
      "text": "혼자 못 움직일 정도는 아니었습니다. 그런데"
    },
    {
      "start": 922.517,
      "end": 925.525,
      "text": "아래쪽이 바닥에서 떨어지지 않았어요. 검은"
    },
    {
      "start": 925.525,
      "end": 928.058,
      "text": "얼룩이 있는 모서리가 벽에 붙은 것처럼"
    },
    {
      "start": 928.058,
      "end": 930.908,
      "text": "버텼습니다. 힘을 주자 문 안쪽에서 의자가"
    },
    {
      "start": 930.908,
      "end": 934.075,
      "text": "끌렸어요. 바로 문 너머에서요. 저는 손을 놓고"
    },
    {
      "start": 934.075,
      "end": 935.5,
      "text": "뒤로 물러났습니다."
    },
    {
      "start": 935.5,
      "end": 938.689,
      "text": "업체에 다시 전화했지만 이번에는 받지 않았어요."
    },
    {
      "start": 938.689,
      "end": 941.726,
      "text": "집주인에게도 물었는데 그런 문을 보낸 적 없다고"
    },
    {
      "start": 941.726,
      "end": 944.156,
      "text": "했죠. 저는 신발을 신고 밖으로 나가려"
    },
    {
      "start": 944.156,
      "end": 947.193,
      "text": "했습니다. 현관문은 열렸어요. 그런데 복도가"
    },
    {
      "start": 947.193,
      "end": 950.23,
      "text": "어두웠습니다. 센서등이 안 들어오는 줄 알고 한"
    },
    {
      "start": 950.23,
      "end": 952.659,
      "text": "발을 내밀었죠. 발밑에서 나무 바닥이"
    },
    {
      "start": 952.659,
      "end": 956.0,
      "text": "삐걱거렸습니다. 우리 건물 복도는 타일이었어요."
    },
    {
      "start": 956.0,
      "end": 959.14,
      "text": "휴대전화 불빛을 비췄습니다. 복도 반대편이"
    },
    {
      "start": 959.14,
      "end": 961.784,
      "text": "아니라, 제가 거실에 세워 둔 나무문이"
    },
    {
      "start": 961.784,
      "end": 964.924,
      "text": "보였어요. 검은 얼룩이 왼쪽 아래에 있는 바로"
    },
    {
      "start": 964.924,
      "end": 967.733,
      "text": "그 문이요. 뒤를 돌아보니 집 안의 주방과"
    },
    {
      "start": 967.733,
      "end": 970.873,
      "text": "매트는 그대로였습니다. 나가면 그 문 앞으로"
    },
    {
      "start": 970.873,
      "end": 973.847,
      "text": "돌아가는 거였어요. 저는 현관문을 닫고 집"
    },
    {
      "start": 973.847,
      "end": 975.5,
      "text": "안으로 들어왔습니다."
    },
    {
      "start": 975.5,
      "end": 979.027,
      "text": "담당자에게 문자가 왔어요. 전화는 어렵다면서,"
    },
    {
      "start": 979.027,
      "end": 981.714,
      "text": "문이 서 있으면 자꾸 세워 두고 싶어질 수"
    },
    {
      "start": 981.714,
      "end": 985.073,
      "text": "있다고 했습니다. 무슨 말인지 물었죠. 돌아온"
    },
    {
      "start": 985.073,
      "end": 988.431,
      "text": "답은 짧았습니다. 누가 안에서 부탁해도 받침을"
    },
    {
      "start": 988.431,
      "end": 991.454,
      "text": "대지 마세요. 저는 그 문자를 읽다가 거실을"
    },
    {
      "start": 991.454,
      "end": 994.645,
      "text": "봤습니다. 이삿짐 상자 하나가 문 밑에 끼워져"
    },
    {
      "start": 994.645,
      "end": 997.5,
      "text": "있었어요. 제가 넣은 건 아니었습니다."
    },
    {
      "start": 997.5,
      "end": 1000.758,
      "text": "문 너머에서 여자 목소리가 났어요. 상자 하나만"
    },
    {
      "start": 1000.758,
      "end": 1003.364,
      "text": "더 넣어 달라고 했습니다. 아래가 자꾸"
    },
    {
      "start": 1003.364,
      "end": 1006.621,
      "text": "꺼진다고요. 아주 평범한 목소리였어요. 옆집"
    },
    {
      "start": 1006.621,
      "end": 1009.39,
      "text": "사람이 가구 옮기는 걸 도와 달라는 말처럼"
    },
    {
      "start": 1009.39,
      "end": 1012.648,
      "text": "들렸습니다. 저는 대답하지 않았어요. 그러자"
    },
    {
      "start": 1012.648,
      "end": 1015.742,
      "text": "문이 상자 위에서 조금씩 올라갔습니다. 경첩"
    },
    {
      "start": 1015.742,
      "end": 1019.0,
      "text": "아래에 생긴 틈으로 흰 양말 앞부분이 보였어요."
    },
    {
      "start": 1019.0,
      "end": 1021.838,
      "text": "그 양말은 바닥을 딛고 있지 않았어요. 문과"
    },
    {
      "start": 1021.838,
      "end": 1024.992,
      "text": "함께 올라가고 있었습니다. 아래로 처진 발끝이"
    },
    {
      "start": 1024.992,
      "end": 1028.146,
      "text": "상자를 누르자 골판지가 찌그러졌어요. 그제야"
    },
    {
      "start": 1028.146,
      "end": 1031.458,
      "text": "상자가 받침이라는 말을 이해했습니다. 문을 세워"
    },
    {
      "start": 1031.458,
      "end": 1034.454,
      "text": "두는 게 아니라, 안쪽에 있는 것을 들어 올리는"
    },
    {
      "start": 1034.454,
      "end": 1037.608,
      "text": "받침이었던 거예요. 문 위쪽에서는 벽지가 길게"
    },
    {
      "start": 1037.608,
      "end": 1039.5,
      "text": "갈라지는 소리가 났습니다."
    },
    {
      "start": 1039.5,
      "end": 1042.69,
      "text": "저는 매트 옆에 놓인 긴 우산을 집었습니다. 문"
    },
    {
      "start": 1042.69,
      "end": 1045.881,
      "text": "가까이 가고 싶지는 않았어요. 우산 끝을 상자"
    },
    {
      "start": 1045.881,
      "end": 1049.071,
      "text": "옆 틈에 넣고, 제 쪽으로 당겼습니다. 상자가"
    },
    {
      "start": 1049.071,
      "end": 1052.093,
      "text": "조금 나왔어요. 문이 기울면서 안의 발끝도"
    },
    {
      "start": 1052.093,
      "end": 1055.619,
      "text": "내려갔죠. 여자 목소리가 처음으로 커졌습니다."
    },
    {
      "start": 1055.619,
      "end": 1058.642,
      "text": "그러지 말라고요. 그런데 말이 문 위쪽에서"
    },
    {
      "start": 1058.642,
      "end": 1062.0,
      "text": "들렸어요. 발이 있는 곳보다 훨씬 높았습니다."
    },
    {
      "start": 1062.0,
      "end": 1065.167,
      "text": "상자가 빠지자 문이 앞으로 넘어왔어요. 저는"
    },
    {
      "start": 1065.167,
      "end": 1068.333,
      "text": "옆으로 물러났습니다. 문 아래가 바닥을 밀며"
    },
    {
      "start": 1068.333,
      "end": 1071.333,
      "text": "움직이고, 뒤의 검은 틈이 넓어졌어요. 그"
    },
    {
      "start": 1071.333,
      "end": 1074.5,
      "text": "안에는 복도 같은 공간이 있었습니다. 양쪽에"
    },
    {
      "start": 1074.5,
      "end": 1077.5,
      "text": "문이 줄지어 있었죠. 가장 가까운 문은 제가"
    },
    {
      "start": 1077.5,
      "end": 1080.333,
      "text": "세워 둔 것과 똑같았습니다. 아래의 검은"
    },
    {
      "start": 1080.333,
      "end": 1083.5,
      "text": "얼룩까지요. 그 뒤에도, 그 뒤에도 같은 문이"
    },
    {
      "start": 1083.5,
      "end": 1084.5,
      "text": "있었습니다."
    },
    {
      "start": 1084.5,
      "end": 1087.246,
      "text": "첫 번째 문 위에서 손가락이 나왔어요. 문"
    },
    {
      "start": 1087.246,
      "end": 1089.831,
      "text": "윗면을 붙들고, 넘어지지 않게 버티고"
    },
    {
      "start": 1089.831,
      "end": 1093.223,
      "text": "있었습니다. 손은 하나가 아니었어요. 멀리 있는"
    },
    {
      "start": 1093.223,
      "end": 1096.454,
      "text": "문들 위에도 손가락이 있었습니다. 가까운 문이"
    },
    {
      "start": 1096.454,
      "end": 1099.523,
      "text": "기울면 뒤의 문들도 같은 방향으로 기울었죠."
    },
    {
      "start": 1099.523,
      "end": 1102.592,
      "text": "저는 우산을 놓고 문 모서리를 잡았습니다. 그"
    },
    {
      "start": 1102.592,
      "end": 1105.5,
      "text": "손가락들과 줄다리기를 하는 것 같았어요."
    },
    {
      "start": 1105.5,
      "end": 1107.75,
      "text": "저는 문을 앞으로 더 당기면서 옆으로"
    },
    {
      "start": 1107.75,
      "end": 1110.75,
      "text": "돌렸습니다. 담당자가 말한 경첩이 위를 향하게"
    },
    {
      "start": 1110.75,
      "end": 1113.3,
      "text": "하려고요. 문이 제 쪽으로 넘어오다가,"
    },
    {
      "start": 1113.3,
      "end": 1116.45,
      "text": "마지막에는 손에서 빠져 바닥에 떨어졌습니다. 큰"
    },
    {
      "start": 1116.45,
      "end": 1118.7,
      "text": "소리가 났어요. 거실 끝의 벽이 다시"
    },
    {
      "start": 1118.7,
      "end": 1122.0,
      "text": "보였습니다. 갈라졌던 벽지도 멀쩡했죠. 손가락은"
    },
    {
      "start": 1122.0,
      "end": 1125.0,
      "text": "없었습니다. 바닥에 누운 문만 덜컹거렸어요."
    },
    {
      "start": 1125.0,
      "end": 1127.607,
      "text": "현관을 열어 봤어요. 이번에는 타일 복도가"
    },
    {
      "start": 1127.607,
      "end": 1130.505,
      "text": "보였고 센서등도 켜졌습니다. 저는 휴대전화와"
    },
    {
      "start": 1130.505,
      "end": 1133.257,
      "text": "가방만 들고 밖으로 나왔어요. 그날 밤은 근처"
    },
    {
      "start": 1133.257,
      "end": 1136.154,
      "text": "숙소에서 잤습니다. 문을 확인하러 돌아가지는"
    },
    {
      "start": 1136.154,
      "end": 1139.196,
      "text": "않았어요. 업체에는 아침에 집 밖에서 만나겠다고"
    },
    {
      "start": 1139.196,
      "end": 1140.5,
      "text": "문자만 보냈습니다."
    },
    {
      "start": 1140.5,
      "end": 1142.992,
      "text": "수거하러 온 기사님은 문을 보자 천으로"
    },
    {
      "start": 1142.992,
      "end": 1145.795,
      "text": "감쌌어요. 두 사람이 처음부터 끝까지 눕힌"
    },
    {
      "start": 1145.795,
      "end": 1148.91,
      "text": "상태로 옮겼습니다. 저는 어디서 온 물건이냐고"
    },
    {
      "start": 1148.91,
      "end": 1152.18,
      "text": "물었죠. 기사님은 빈집 정리 물건이라고 했어요."
    },
    {
      "start": 1152.18,
      "end": 1154.828,
      "text": "담당자가 왜 받침을 대지 말라고 했는지도"
    },
    {
      "start": 1154.828,
      "end": 1157.943,
      "text": "물었습니다. 그런 말을 했냐고 되묻더니, 더는"
    },
    {
      "start": 1157.943,
      "end": 1159.5,
      "text": "대답하지 않았습니다."
    },
    {
      "start": 1159.5,
      "end": 1162.725,
      "text": "짐을 다 정리한 뒤에도 거실 끝에는 가구를 놓지"
    },
    {
      "start": 1162.725,
      "end": 1165.271,
      "text": "않았어요. 벽에 물건을 기대는 것도"
    },
    {
      "start": 1165.271,
      "end": 1168.495,
      "text": "싫어졌습니다. 한 달쯤 지나 이사 비용 서류를"
    },
    {
      "start": 1168.495,
      "end": 1171.89,
      "text": "받았는데, 수거 사진이 같이 들어 있더라고요."
    },
    {
      "start": 1171.89,
      "end": 1174.775,
      "text": "트럭에 눕혀 놓은 문이 찍혀 있었습니다."
    },
    {
      "start": 1174.775,
      "end": 1178.0,
      "text": "사진에서는 경첩이 아래를 향하고 있었어요."
    },
    {
      "start": 1178.0,
      "end": 1181.095,
      "text": "저는 업체에 바로 전화했습니다. 그 문을 다시"
    },
    {
      "start": 1181.095,
      "end": 1184.189,
      "text": "세웠냐고 물었죠. 담당자는 잠깐 세워야 짐이"
    },
    {
      "start": 1184.189,
      "end": 1187.284,
      "text": "들어가서, 창고 벽에 세워 뒀다고 했습니다."
    },
    {
      "start": 1187.284,
      "end": 1190.542,
      "text": "저는 눕혀 달라고 말했어요. 지금 바로요. 그때"
    },
    {
      "start": 1190.542,
      "end": 1193.799,
      "text": "전화기 너머에서 상자를 끄는 소리가 났습니다."
    },
    {
      "start": 1193.799,
      "end": 1197.057,
      "text": "담당자는 잠깐만 기다리라고 했죠. 안에서 누가"
    },
    {
      "start": 1197.057,
      "end": 1199.5,
      "text": "받침을 하나 더 달라고 한다면서요."
    }
  ]
}
