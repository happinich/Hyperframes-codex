      "caption_cues": [
        {
          "start": 0.0,
          "end": 2.12,
          "text": "캠핑장 울타리 밖에서, 누가 제"
        },
        {
          "start": 2.12,
          "end": 3.32,
          "text": "움직임을 따라 했어요."
        },
        {
          "start": 3.72,
          "end": 6.66,
          "text": "제가 앉으면 풀이 눌렸고, 손뼉을 치면"
        },
        {
          "start": 6.66,
          "end": 7.98,
          "text": "같은 소리가 돌아왔죠."
        },
        {
          "start": 8.56,
          "end": 11.22,
          "text": "다른 캠핑객은 없었고, 관리실은 전화를"
        },
        {
          "start": 11.22,
          "end": 12.04,
          "text": "받지 않았습니다."
        },
        {
          "start": 12.76,
          "end": 15.22,
          "text": "랜턴을 들어 보니 철망보다 높은 곳에"
        },
        {
          "start": 15.22,
          "end": 16.18,
          "text": "머리가 있었어요."
        },
        {
          "start": 16.76,
          "end": 19.14,
          "text": "그런데 그 머리가 내려오기 시작했습니다."
        },
        {
          "start": 19.56,
          "end": 22.72,
          "text": "무릎을 굽히는 게 아니라, 몸통을 접고 있었습니다."
        }
      ]
    },
