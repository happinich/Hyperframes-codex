{
  "source": "scene-plan.json",
  "cues": [
    {
      "start": 0.0,
      "end": 3.429,
      "text": "여자가 제 장화를 신고 물에서 올라왔어요."
    },
    {
      "start": 3.429,
      "end": 6.667,
      "text": "그런데 장화 안에 들어 있는 건 발이 아니라"
    },
    {
      "start": 6.667,
      "end": 8.0,
      "text": "손이었습니다."
    },
    {
      "start": 8.0,
      "end": 11.172,
      "text": "그날은 친구와 저수지에서 밤낚시를"
    },
    {
      "start": 11.172,
      "end": 14.767,
      "text": "하기로 했어요. 제가 먼저 가고, 친구는"
    },
    {
      "start": 14.767,
      "end": 18.361,
      "text": "가게 문을 닫은 뒤에 오기로 했죠. 낚시는"
    },
    {
      "start": 18.361,
      "end": 21.956,
      "text": "아버지를 따라다닐 때부터 해 왔습니다."
    },
    {
      "start": 21.956,
      "end": 25.551,
      "text": "처음 가는 곳도 아니었어요. 관리실에서"
    },
    {
      "start": 25.551,
      "end": 28.934,
      "text": "열쇠를 받아 물 위에 떠 있는 작은 좌대로"
    },
    {
      "start": 28.934,
      "end": 32.317,
      "text": "들어갔습니다. 난간 안쪽에는 의자가"
    },
    {
      "start": 32.317,
      "end": 35.912,
      "text": "놓여 있었고, 뒤에는 잠깐 쉴 수 있는 방이"
    },
    {
      "start": 35.912,
      "end": 39.507,
      "text": "붙어 있었죠. 육지까지는 좁은 나무 다리"
    },
    {
      "start": 39.507,
      "end": 42.678,
      "text": "하나로 연결돼 있었습니다. 육지 쪽"
    },
    {
      "start": 42.678,
      "end": 45.427,
      "text": "난간에는 긴 뜰채 하나가 기대어"
    },
    {
      "start": 45.427,
      "end": 49.022,
      "text": "있었어요. 흙 묻은 장화를 방 앞에 벗고,"
    },
    {
      "start": 49.022,
      "end": 52.405,
      "text": "가져간 운동화로 갈아 신었어요. 날이"
    },
    {
      "start": 52.405,
      "end": 56.0,
      "text": "차가워져서 두꺼운 점퍼도 입었습니다."
    },
    {
      "start": 56.0,
      "end": 58.946,
      "text": "낚싯대를 내려놓은 지 얼마 안 됐을 때였어요."
    },
    {
      "start": 58.946,
      "end": 61.738,
      "text": "찌가 옆으로 조금 움직였습니다. 잠기는 게"
    },
    {
      "start": 61.738,
      "end": 64.684,
      "text": "아니라, 다른 사람 줄에 걸린 것처럼 일정하게"
    },
    {
      "start": 64.684,
      "end": 67.166,
      "text": "끌려갔어요. 그런데 그쪽 좌대는 비어"
    },
    {
      "start": 67.166,
      "end": 69.957,
      "text": "있었습니다. 불도 꺼져 있었고, 낚싯대도"
    },
    {
      "start": 69.957,
      "end": 72.593,
      "text": "없었어요. 줄을 조금 감았더니 움직임이"
    },
    {
      "start": 72.593,
      "end": 75.695,
      "text": "멎었습니다. 물고기가 걸렸나 싶어서 손잡이를"
    },
    {
      "start": 75.695,
      "end": 78.331,
      "text": "천천히 돌렸죠. 그때 줄이 제가 감는 만큼"
    },
    {
      "start": 78.331,
      "end": 80.192,
      "text": "반대쪽으로 풀려 나갔어요."
    },
    {
      "start": 80.192,
      "end": 83.12,
      "text": "낚싯대를 세우자 무언가 아래에서 버티는 느낌이"
    },
    {
      "start": 83.12,
      "end": 86.049,
      "text": "났습니다. 바닥에 걸린 줄 알았어요. 힘을 빼고"
    },
    {
      "start": 86.049,
      "end": 89.124,
      "text": "방향을 바꿨는데도 따라왔죠. 왼쪽으로 움직이면"
    },
    {
      "start": 89.124,
      "end": 92.199,
      "text": "왼쪽으로, 오른쪽으로 가면 오른쪽으로요. 저는"
    },
    {
      "start": 92.199,
      "end": 94.834,
      "text": "더 당기지 않고 줄을 느슨하게 풀었습니다."
    },
    {
      "start": 94.834,
      "end": 97.616,
      "text": "그러자 물 위로 작은 동그라미가 올라왔어요."
    },
    {
      "start": 97.616,
      "end": 100.545,
      "text": "가까이 보니 거품이었습니다. 꼭 누가 물속에서"
    },
    {
      "start": 100.545,
      "end": 102.448,
      "text": "길게 숨을 내쉬는 것 같았어요."
    },
    {
      "start": 102.448,
      "end": 105.436,
      "text": "저수지 가운데서 물새가 한 번 울었습니다. 그"
    },
    {
      "start": 105.436,
      "end": 108.109,
      "text": "소리가 끊기자 방 쪽에서 툭, 하는 소리가"
    },
    {
      "start": 108.109,
      "end": 111.411,
      "text": "났어요. 뭐가 떨어졌나 싶어 돌아봤습니다. 벗어"
    },
    {
      "start": 111.411,
      "end": 114.399,
      "text": "둔 장화 하나가 옆으로 누워 있더라고요. 제가"
    },
    {
      "start": 114.399,
      "end": 117.229,
      "text": "문을 여닫다가 건드렸겠거니 하고 다시 세워"
    },
    {
      "start": 117.229,
      "end": 120.374,
      "text": "놨죠. 그런데 안쪽이 젖어 있었습니다. 오면서"
    },
    {
      "start": 120.374,
      "end": 123.361,
      "text": "밟은 건 흙뿐이었는데요. 손을 넣어 보려다가"
    },
    {
      "start": 123.361,
      "end": 126.349,
      "text": "말았습니다. 고무 안에서 물방울이 떨어지는"
    },
    {
      "start": 126.349,
      "end": 127.607,
      "text": "소리가 났거든요."
    },
    {
      "start": 127.607,
      "end": 130.233,
      "text": "그 사이 낚싯줄은 난간 바로 아래로 당겨져"
    },
    {
      "start": 130.233,
      "end": 133.168,
      "text": "있었습니다. 물살도 없는데 찌가 좌대 밑으로"
    },
    {
      "start": 133.168,
      "end": 136.258,
      "text": "들어가 있었어요. 저는 손전등을 꺼냈습니다."
    },
    {
      "start": 136.258,
      "end": 139.039,
      "text": "바닥 틈 사이를 비추자 나무 판자 밑에서 검은"
    },
    {
      "start": 139.039,
      "end": 142.283,
      "text": "것이 조금씩 흔들렸어요. 비닐봉지인 줄 알았죠."
    },
    {
      "start": 142.283,
      "end": 145.527,
      "text": "그런데 빛을 따라 가느다란 것들이 벌어졌습니다."
    },
    {
      "start": 145.527,
      "end": 148.617,
      "text": "머리카락이었어요. 한두 가닥이 아니라, 사람"
    },
    {
      "start": 148.617,
      "end": 151.552,
      "text": "머리 하나를 덮을 만큼 빽빽한 머리카락이 좌대"
    },
    {
      "start": 151.552,
      "end": 153.251,
      "text": "아래에 붙어 있었습니다."
    },
    {
      "start": 153.251,
      "end": 156.456,
      "text": "순간 손전등을 떨어뜨릴 뻔했어요. 사람이 빠진"
    },
    {
      "start": 156.456,
      "end": 159.66,
      "text": "건가 싶었습니다. 난간 밖으로 몸을 내밀고 누구"
    },
    {
      "start": 159.66,
      "end": 163.025,
      "text": "있냐고 물었죠. 대답은 없었어요. 대신 낚싯줄이"
    },
    {
      "start": 163.025,
      "end": 166.229,
      "text": "한 번 더 팽팽해졌습니다. 검은 머리카락 옆으로"
    },
    {
      "start": 166.229,
      "end": 169.113,
      "text": "하얀 손이 올라왔어요. 손등이 위를 향한 채"
    },
    {
      "start": 169.113,
      "end": 172.478,
      "text": "줄을 감고 있었습니다. 손목은 보이지 않았어요."
    },
    {
      "start": 172.478,
      "end": 175.523,
      "text": "저는 줄을 놓고 뒤로 물러났습니다. 그러자 그"
    },
    {
      "start": 175.523,
      "end": 177.926,
      "text": "손이 물 아래로 천천히 가라앉았죠."
    },
    {
      "start": 177.926,
      "end": 181.165,
      "text": "휴대전화로 관리실 번호를 눌렀습니다. 연결이 안"
    },
    {
      "start": 181.165,
      "end": 184.249,
      "text": "되더라고요. 친구에게 전화를 걸면서 방 쪽으로"
    },
    {
      "start": 184.249,
      "end": 187.488,
      "text": "갔어요. 친구는 이제 출발한다고 했습니다. 저는"
    },
    {
      "start": 187.488,
      "end": 190.264,
      "text": "사람이 물에 빠진 것 같다고 말했죠. 친구가"
    },
    {
      "start": 190.264,
      "end": 193.194,
      "text": "신고부터 하라고 해서 전화를 끊고 구조 요청을"
    },
    {
      "start": 193.194,
      "end": 195.816,
      "text": "했어요. 위치를 말하고 기다리라는 답을"
    },
    {
      "start": 195.816,
      "end": 198.592,
      "text": "들었습니다. 이상하게도 그때는 무섭다는"
    },
    {
      "start": 198.592,
      "end": 201.368,
      "text": "생각보다, 제가 저 사람을 그냥 두고 있다는"
    },
    {
      "start": 201.368,
      "end": 202.602,
      "text": "생각이 더 컸어요."
    },
    {
      "start": 202.602,
      "end": 204.922,
      "text": "방 앞에 도착해서야 장화가 없어진 걸"
    },
    {
      "start": 204.922,
      "end": 207.707,
      "text": "알아챘습니다. 두 짝 다요. 운동화는 신고"
    },
    {
      "start": 207.707,
      "end": 210.491,
      "text": "있었고, 장화를 옮긴 적은 없었습니다. 문"
    },
    {
      "start": 210.491,
      "end": 213.276,
      "text": "옆에서 난간까지 젖은 자국이 이어졌어요."
    },
    {
      "start": 213.276,
      "end": 216.679,
      "text": "가느다란 발자국이 아니라 손바닥 자국이었습니다."
    },
    {
      "start": 216.679,
      "end": 219.618,
      "text": "엄지손가락이 밖을 향한 자국들이 번갈아 찍혀"
    },
    {
      "start": 219.618,
      "end": 222.558,
      "text": "있었어요. 누군가 손으로 바닥을 짚고, 제가"
    },
    {
      "start": 222.558,
      "end": 225.342,
      "text": "낚싯대를 세워 둔 쪽으로 간 것 같았습니다."
    },
    {
      "start": 225.342,
      "end": 228.639,
      "text": "밖에서 고무가 나무를 문지르는 소리가 났습니다."
    },
    {
      "start": 228.639,
      "end": 231.779,
      "text": "저는 방문 옆에서 멈췄어요. 난간 아래에 장화가"
    },
    {
      "start": 231.779,
      "end": 234.134,
      "text": "떠 있었습니다. 정확히는 떠 있는 게"
    },
    {
      "start": 234.134,
      "end": 236.803,
      "text": "아니었어요. 장화 윗부분은 물 위에 나와"
    },
    {
      "start": 236.803,
      "end": 239.944,
      "text": "있는데, 밑창은 물속을 딛고 있었습니다. 발목"
    },
    {
      "start": 239.944,
      "end": 243.084,
      "text": "부분이 한 번씩 안쪽으로 찌그러졌어요. 두 짝이"
    },
    {
      "start": 243.084,
      "end": 246.381,
      "text": "번갈아 움직이면서 좌대 쪽으로 다가왔습니다. 그"
    },
    {
      "start": 246.381,
      "end": 249.05,
      "text": "사이에서 젖은 회색 소매가 올라왔어요."
    },
    {
      "start": 249.05,
      "end": 252.259,
      "text": "장화 하나가 난간 밑의 낮은 턱에 걸렸습니다."
    },
    {
      "start": 252.259,
      "end": 255.131,
      "text": "다른 한 짝이 그 옆으로 따라 올라왔죠. 그"
    },
    {
      "start": 255.131,
      "end": 258.509,
      "text": "위로 몸이 조금씩 나왔어요. 여자는 회색 니트를"
    },
    {
      "start": 258.509,
      "end": 261.549,
      "text": "입고 있었고, 긴 머리카락이 얼굴을 가리고"
    },
    {
      "start": 261.549,
      "end": 264.928,
      "text": "있었습니다. 몸을 세우는 게 아니라 어깨와 등을"
    },
    {
      "start": 264.928,
      "end": 268.475,
      "text": "먼저 밀어 올렸어요. 허리가 올라왔는데도 다리는"
    },
    {
      "start": 268.475,
      "end": 271.853,
      "text": "보이지 않았습니다. 그제야 장화 안에 들어 있는"
    },
    {
      "start": 271.853,
      "end": 275.062,
      "text": "게 뭔지 보였어요. 두 손이었습니다. 손가락"
    },
    {
      "start": 275.062,
      "end": 277.596,
      "text": "끝이 장화 바닥을 누르고 있었어요."
    },
    {
      "start": 277.596,
      "end": 280.081,
      "text": "저는 방 안으로 들어가 문을 닫았습니다."
    },
    {
      "start": 280.081,
      "end": 283.15,
      "text": "잠금쇠를 걸려는데 손이 자꾸 헛돌더라고요. 겨우"
    },
    {
      "start": 283.15,
      "end": 286.073,
      "text": "걸고 휴대전화를 봤습니다. 친구가 전화를 걸고"
    },
    {
      "start": 286.073,
      "end": 288.558,
      "text": "있었어요. 저는 받자마자 사람 아니라고"
    },
    {
      "start": 288.558,
      "end": 291.189,
      "text": "말했습니다. 왜 그러냐고 묻는데 설명이 안"
    },
    {
      "start": 291.189,
      "end": 294.404,
      "text": "됐어요. 장화를 신고 올라왔다고만 반복했습니다."
    },
    {
      "start": 294.404,
      "end": 297.473,
      "text": "친구는 다리 쪽으로 나와서 기다리라고 했습니다."
    },
    {
      "start": 297.473,
      "end": 300.396,
      "text": "자기가 곧 도착한다고요. 그때 문 밖에서 여자가"
    },
    {
      "start": 300.396,
      "end": 303.32,
      "text": "말했습니다. 이거 신고 어디까지 가요. 장화를"
    },
    {
      "start": 303.32,
      "end": 305.658,
      "text": "신고 어디까지 가냐고 묻고 있었어요."
    },
    {
      "start": 305.658,
      "end": 308.501,
      "text": "친구의 목소리는 전화기에서 계속 들리고"
    },
    {
      "start": 308.501,
      "end": 311.512,
      "text": "있었습니다. 그런데 문 밖의 여자는 그 말을"
    },
    {
      "start": 311.512,
      "end": 314.522,
      "text": "하는 동안 숨을 쉬지 않았어요. 말을 끝내고"
    },
    {
      "start": 314.522,
      "end": 317.867,
      "text": "나서야 물을 쏟는 소리가 났습니다. 방문 아래로"
    },
    {
      "start": 317.867,
      "end": 321.045,
      "text": "물이 들어왔어요. 고무 밑창이 문 바로 앞에서"
    },
    {
      "start": 321.045,
      "end": 324.223,
      "text": "멎었습니다. 저는 통화를 끊지 않고 전화기를"
    },
    {
      "start": 324.223,
      "end": 327.066,
      "text": "침상 위에 내려놨어요. 문 아래 틈을 보지"
    },
    {
      "start": 327.066,
      "end": 330.411,
      "text": "않으려고 고개를 숙였습니다. 그 틈에서 손가락"
    },
    {
      "start": 330.411,
      "end": 332.753,
      "text": "하나가 바닥을 훑고 있었습니다."
    },
    {
      "start": 332.753,
      "end": 335.81,
      "text": "안에 있으면 안 된다는 생각이 들었어요. 방"
    },
    {
      "start": 335.81,
      "end": 339.206,
      "text": "뒤에는 육지로 이어지는 작은 문이 있었습니다."
    },
    {
      "start": 339.206,
      "end": 342.093,
      "text": "아까 짐을 들여놓을 때 열어 본 문이었죠."
    },
    {
      "start": 342.093,
      "end": 345.32,
      "text": "그쪽으로 가서 손잡이를 돌렸습니다. 그런데"
    },
    {
      "start": 345.32,
      "end": 348.037,
      "text": "밖에서 두꺼운 점퍼 소매를 문에 걸어 둔"
    },
    {
      "start": 348.037,
      "end": 351.094,
      "text": "것처럼, 문이 조금만 열리고 멎었어요. 틈"
    },
    {
      "start": 351.094,
      "end": 354.49,
      "text": "사이로 나무 다리가 보였습니다. 그리고 제 장화"
    },
    {
      "start": 354.49,
      "end": 357.377,
      "text": "한 짝이 보였어요. 여자는 벌써 그쪽에 와"
    },
    {
      "start": 357.377,
      "end": 358.396,
      "text": "있었습니다."
    },
    {
      "start": 358.396,
      "end": 361.408,
      "text": "문을 밀었더니 장화가 뒤로 조금 미끄러졌어요."
    },
    {
      "start": 361.408,
      "end": 364.42,
      "text": "저는 그 틈으로 뛰어나갔습니다. 손목을 잡히는"
    },
    {
      "start": 364.42,
      "end": 367.582,
      "text": "느낌이 들었는데 돌아보지 않았어요. 점퍼를 잡고"
    },
    {
      "start": 367.582,
      "end": 370.594,
      "text": "있었습니다. 저는 지퍼를 내리고 팔을 뺐어요."
    },
    {
      "start": 370.594,
      "end": 373.456,
      "text": "점퍼가 등 뒤로 확 끌려갔죠. 다리 위에는 물이"
    },
    {
      "start": 373.456,
      "end": 376.769,
      "text": "흥건했습니다. 바닥이 미끄러워 난간을 잡았어요."
    },
    {
      "start": 376.769,
      "end": 379.479,
      "text": "뒤에서는 고무 밑창 두 개가 한꺼번에 나무를"
    },
    {
      "start": 379.479,
      "end": 381.136,
      "text": "치는 소리가 들렸습니다."
    },
    {
      "start": 381.136,
      "end": 384.073,
      "text": "물속에 있던 사람이라면 그럴 수 없었어요."
    },
    {
      "start": 384.073,
      "end": 387.336,
      "text": "소리가 너무 빨랐습니다. 저는 다리 중간에서 한"
    },
    {
      "start": 387.336,
      "end": 390.762,
      "text": "번 넘어졌어요. 손바닥이 나무에 긁혔고, 운동화"
    },
    {
      "start": 390.762,
      "end": 393.536,
      "text": "한 짝이 물 가까운 틈에 걸렸습니다. 발을"
    },
    {
      "start": 393.536,
      "end": 396.31,
      "text": "빼려는데 장화가 제 옆에 멈췄어요. 장화"
    },
    {
      "start": 396.31,
      "end": 399.41,
      "text": "입구에서 젖은 손목이 솟아 있었습니다. 회색"
    },
    {
      "start": 399.41,
      "end": 402.183,
      "text": "소매 위로 여자의 몸이 난간 높이까지 굽어"
    },
    {
      "start": 402.183,
      "end": 405.61,
      "text": "있었어요. 머리카락 끝이 제 손등에 닿았습니다."
    },
    {
      "start": 405.61,
      "end": 408.22,
      "text": "차갑다기보다, 오래 담가 둔 헝겊 같은"
    },
    {
      "start": 408.22,
      "end": 409.199,
      "text": "느낌이었죠."
    },
    {
      "start": 409.199,
      "end": 412.361,
      "text": "여자가 제 운동화 끈을 잡았습니다. 저는 발을"
    },
    {
      "start": 412.361,
      "end": 415.356,
      "text": "뒤로 당겼어요. 더 세게 잡더라고요. 다리"
    },
    {
      "start": 415.356,
      "end": 417.853,
      "text": "위에는 제가 벗어 던진 점퍼도 끌려와"
    },
    {
      "start": 417.853,
      "end": 421.014,
      "text": "있었습니다. 여자는 그 위에 무릎이 있어야 할"
    },
    {
      "start": 421.014,
      "end": 424.343,
      "text": "부분을 내려놓고 있었어요. 하지만 니트 아래로"
    },
    {
      "start": 424.343,
      "end": 427.837,
      "text": "나온 건 다리가 아니었습니다. 옷자락은 납작하게"
    },
    {
      "start": 427.837,
      "end": 430.666,
      "text": "물에 붙어 있었고, 몸 아래에는 아무것도"
    },
    {
      "start": 430.666,
      "end": 433.662,
      "text": "없었어요. 장화 속의 손 두 개가 여자의 몸을"
    },
    {
      "start": 433.662,
      "end": 435.326,
      "text": "떠받치고 있었습니다."
    },
    {
      "start": 435.326,
      "end": 438.449,
      "text": "친구가 제 이름을 부르는 소리가 들렸어요. 육지"
    },
    {
      "start": 438.449,
      "end": 441.26,
      "text": "쪽에서 손전등 불빛이 흔들렸습니다. 저는"
    },
    {
      "start": 441.26,
      "end": 444.228,
      "text": "운동화에서 발을 빼냈어요. 끈을 풀 생각을 할"
    },
    {
      "start": 444.228,
      "end": 447.195,
      "text": "여유가 없었죠. 한쪽 발이 맨발이 된 채 기어서"
    },
    {
      "start": 447.195,
      "end": 450.475,
      "text": "난간 끝으로 갔습니다. 친구가 팔을 뻗었습니다."
    },
    {
      "start": 450.475,
      "end": 453.598,
      "text": "그때 여자가 점퍼 대신 제 종아리를 붙잡았어요."
    },
    {
      "start": 453.598,
      "end": 456.253,
      "text": "손가락이 아니라, 장화 윗부분이 다리에"
    },
    {
      "start": 456.253,
      "end": 459.064,
      "text": "끼워졌습니다. 고무 안쪽에서 손이 발목을"
    },
    {
      "start": 459.064,
      "end": 460.001,
      "text": "조였습니다."
    },
    {
      "start": 460.001,
      "end": 463.069,
      "text": "친구가 양팔로 저를 잡아당겼습니다. 저는 다리"
    },
    {
      "start": 463.069,
      "end": 465.677,
      "text": "끝을 붙들었어요. 뒤로 끌리는 힘 때문에"
    },
    {
      "start": 465.677,
      "end": 468.592,
      "text": "손가락이 펴졌습니다. 친구가 옆에 세워 둔 긴"
    },
    {
      "start": 468.592,
      "end": 471.2,
      "text": "뜰채를 가져와 장화와 제 다리 사이에 밀어"
    },
    {
      "start": 471.2,
      "end": 474.422,
      "text": "넣었어요. 고무가 조금 벌어졌습니다. 그 안에서"
    },
    {
      "start": 474.422,
      "end": 477.49,
      "text": "손가락들이 뜰채 손잡이를 감았습니다. 친구가"
    },
    {
      "start": 477.49,
      "end": 480.252,
      "text": "손잡이를 옆으로 비틀자 여자의 어깨도 같은"
    },
    {
      "start": 480.252,
      "end": 483.32,
      "text": "방향으로 기울었어요. 몸이 난간에 부딪히면서"
    },
    {
      "start": 483.32,
      "end": 485.161,
      "text": "손의 힘이 잠깐 풀렸습니다."
    },
    {
      "start": 485.161,
      "end": 488.402,
      "text": "그 틈에 친구가 저를 육지로 끌어냈어요. 우리는"
    },
    {
      "start": 488.402,
      "end": 491.48,
      "text": "몇 걸음 뒤로 물러났습니다. 여자는 다리 끝에"
    },
    {
      "start": 491.48,
      "end": 494.883,
      "text": "그대로 붙어 있었습니다. 머리카락이 물에 늘어져"
    },
    {
      "start": 494.883,
      "end": 497.637,
      "text": "있었고, 제 점퍼가 그 아래 깔려 있었죠."
    },
    {
      "start": 497.637,
      "end": 500.878,
      "text": "친구는 저를 보지 않고 그쪽만 보고 있었습니다."
    },
    {
      "start": 500.878,
      "end": 503.956,
      "text": "뜰채 손잡이를 아직 잡고 있었거든요. 반대쪽"
    },
    {
      "start": 503.956,
      "end": 507.197,
      "text": "끝은 장화 안에서 빠지지 않았습니다. 손잡이가"
    },
    {
      "start": 507.197,
      "end": 510.437,
      "text": "천천히 휘더니 친구 손에서 미끄러져 나갔어요."
    },
    {
      "start": 510.437,
      "end": 513.192,
      "text": "물이 한 번 크게 튀었습니다. 여자의 몸이"
    },
    {
      "start": 513.192,
      "end": 516.108,
      "text": "보이지 않았어요. 다리 끝에는 장화만 남아"
    },
    {
      "start": 516.108,
      "end": 519.187,
      "text": "있었습니다. 친구가 휴대전화로 그쪽을 한 장"
    },
    {
      "start": 519.187,
      "end": 519.997,
      "text": "찍었어요."
    },
    {
      "start": 519.997,
      "end": 523.363,
      "text": "저는 친구에게 같이 가자고 했습니다. 친구는"
    },
    {
      "start": 523.363,
      "end": 526.551,
      "text": "한참 뒤에야 돌아섰어요. 차까지 가는 동안"
    },
    {
      "start": 526.551,
      "end": 529.74,
      "text": "뒤에서 물 튀는 소리가 들렸습니다. 한 번,"
    },
    {
      "start": 529.74,
      "end": 532.928,
      "text": "조금 뒤에 한 번 더요. 친구는 뛰지 말고 자기"
    },
    {
      "start": 532.928,
      "end": 536.117,
      "text": "팔을 잡으라고 했어요. 저는 한쪽 발로 자꾸"
    },
    {
      "start": 536.117,
      "end": 538.774,
      "text": "미끄러졌거든요. 차 문을 열자마자"
    },
    {
      "start": 538.774,
      "end": 542.317,
      "text": "들어갔습니다. 친구가 시동을 걸면서 옆 창문을"
    },
    {
      "start": 542.317,
      "end": 545.151,
      "text": "확인했어요. 다행히 그 여자는 차 옆에"
    },
    {
      "start": 545.151,
      "end": 548.694,
      "text": "없었습니다. 그런데 손전등을 켜 둔 다리 끝에서"
    },
    {
      "start": 548.694,
      "end": 551.351,
      "text": "장화 두 짝이 우리 쪽을 향해 나란히 서"
    },
    {
      "start": 551.351,
      "end": 552.414,
      "text": "있었습니다."
    },
    {
      "start": 552.414,
      "end": 555.801,
      "text": "출동한 분들과는 저수지 입구에서 만났어요. 저는"
    },
    {
      "start": 555.801,
      "end": 558.704,
      "text": "사람이 물에 있다고 말했다가, 물에 있던 게"
    },
    {
      "start": 558.704,
      "end": 561.929,
      "text": "올라왔다고 정정했습니다. 친구가 제 말을 끊지"
    },
    {
      "start": 561.929,
      "end": 565.155,
      "text": "않았어요. 그 사람도 장화 안에서 움직이던 손을"
    },
    {
      "start": 565.155,
      "end": 568.219,
      "text": "봤으니까요. 좌대에 다시 들어갔을 때 방 문은"
    },
    {
      "start": 568.219,
      "end": 571.444,
      "text": "열려 있었고, 낚싯대는 물에 빠져 있었습니다."
    },
    {
      "start": 571.444,
      "end": 574.509,
      "text": "전화기는 침상 위에 그대로 있었어요. 점퍼와"
    },
    {
      "start": 574.509,
      "end": 577.412,
      "text": "운동화 한 짝은 찾지 못했습니다. 친구가 쓴"
    },
    {
      "start": 577.412,
      "end": 579.992,
      "text": "뜰채는 다리 아래에 걸려 있었습니다."
    },
    {
      "start": 579.992,
      "end": 582.733,
      "text": "다음 날 관리자가 제게 장화 사진을 보내"
    },
    {
      "start": 582.733,
      "end": 586.33,
      "text": "왔어요. 아침에 다리 위에서 찾았다고 했습니다."
    },
    {
      "start": 586.33,
      "end": 589.242,
      "text": "사진 속에는 제가 벗어 뒀던 두 짝이 나란히"
    },
    {
      "start": 589.242,
      "end": 592.154,
      "text": "놓여 있었습니다. 왼쪽 장화에 붙인 파란"
    },
    {
      "start": 592.154,
      "end": 595.238,
      "text": "테이프까지 그대로였죠. 저는 버려 달라고"
    },
    {
      "start": 595.238,
      "end": 598.492,
      "text": "부탁했어요. 친구는 그 사진을 크게 보더니,"
    },
    {
      "start": 598.492,
      "end": 601.576,
      "text": "발목 부분을 보라고 했습니다. 고무 안쪽에"
    },
    {
      "start": 601.576,
      "end": 604.83,
      "text": "손톱으로 긁은 것 같은 자국이 나 있었습니다."
    },
    {
      "start": 604.83,
      "end": 607.571,
      "text": "한 짝에 다섯 개씩, 안에서 밖으로요."
    },
    {
      "start": 607.571,
      "end": 610.992,
      "text": "그날 친구가 보낸 다른 사진도 있어요. 저를"
    },
    {
      "start": 610.992,
      "end": 614.032,
      "text": "끌어낸 직후, 여자가 물로 떨어졌다고"
    },
    {
      "start": 614.032,
      "end": 616.883,
      "text": "생각했을 때 찍은 사진입니다. 물은"
    },
    {
      "start": 616.883,
      "end": 620.304,
      "text": "조용했고 방에는 불이 켜져 있었습니다. 제"
    },
    {
      "start": 620.304,
      "end": 623.344,
      "text": "장화가 놓인 다리 아래에, 회색 옷자락"
    },
    {
      "start": 623.344,
      "end": 626.575,
      "text": "하나가 물에 떠 있었어요. 저는 처음엔 그"
    },
    {
      "start": 626.575,
      "end": 629.045,
      "text": "여자가 다시 물속으로 들어간 줄"
    },
    {
      "start": 629.045,
      "end": 632.466,
      "text": "알았습니다. 그런데 자세히 보니 옷자락은"
    },
    {
      "start": 632.466,
      "end": 635.887,
      "text": "물 위에 떠 있는 게 아니었습니다. 다리 밑의"
    },
    {
      "start": 635.887,
      "end": 639.307,
      "text": "나무에 붙어 있었어요. 머리카락은 아래로"
    },
    {
      "start": 639.307,
      "end": 642.728,
      "text": "늘어져 있었고, 두 손은 육지 쪽 끝을 붙잡고"
    },
    {
      "start": 642.728,
      "end": 646.149,
      "text": "있었습니다. 장화를 벗겨 놓고도 안심할 수"
    },
    {
      "start": 646.149,
      "end": 649.189,
      "text": "없었던 겁니다. 친구가 그 사진을 찍는"
    },
    {
      "start": 649.189,
      "end": 652.23,
      "text": "동안, 그 여자는 다리 아래로 건너오고"
    },
    {
      "start": 652.23,
      "end": 653.18,
      "text": "있었어요."
    }
  ]
}
