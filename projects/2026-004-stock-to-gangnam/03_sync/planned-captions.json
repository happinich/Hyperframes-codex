{
  "source": "scene-plan.json",
  "cues": [
    {
      "start": 0.0,
      "end": 3.435,
      "text": "주식으로 번 돈, 결국 어디로 갈까요?"
    },
    {
      "start": 3.435,
      "end": 6.655,
      "text": "지금 화면에 나오는 이 숫자를 보시면"
    },
    {
      "start": 6.655,
      "end": 10.089,
      "text": "흐름이 꽤 선명합니다. 올해 1월부터"
    },
    {
      "start": 10.089,
      "end": 13.524,
      "text": "4월까지, 주식과 채권을 팔아 마련한"
    },
    {
      "start": 13.524,
      "end": 16.53,
      "text": "돈 3조 7천억 원 넘는 자금이 주택"
    },
    {
      "start": 16.53,
      "end": 19.964,
      "text": "매입으로 들어갔습니다. 이건 단순한"
    },
    {
      "start": 19.964,
      "end": 22.97,
      "text": "뉴스가 아닙니다. 돈이 움직이기"
    },
    {
      "start": 22.97,
      "end": 25.331,
      "text": "시작했다는 신호거든요."
    },
    {
      "start": 25.331,
      "end": 28.797,
      "text": "더 흥미로운 건 방향입니다. 이 자금의 약"
    },
    {
      "start": 28.797,
      "end": 31.855,
      "text": "65%가 서울 주택으로 들어갔고,"
    },
    {
      "start": 31.855,
      "end": 35.117,
      "text": "그중에서도 강남구, 송파구, 서초구"
    },
    {
      "start": 35.117,
      "end": 37.563,
      "text": "같은 강남 3구에 가장 강하게"
    },
    {
      "start": 37.563,
      "end": 40.214,
      "text": "몰렸습니다. 특히 강남구에는"
    },
    {
      "start": 40.214,
      "end": 43.476,
      "text": "3천7백억 원대 자금이 들어간 것으로"
    },
    {
      "start": 43.476,
      "end": 46.33,
      "text": "보도됐습니다. 그러니까 질문은"
    },
    {
      "start": 46.33,
      "end": 49.184,
      "text": "이겁니다. 사람들이 주식을 팔고"
    },
    {
      "start": 49.184,
      "end": 52.242,
      "text": "부동산으로 갈아탄다면, 왜 첫 번째"
    },
    {
      "start": 52.242,
      "end": 54.281,
      "text": "목적지는 강남일까요?"
    },
    {
      "start": 54.281,
      "end": 57.558,
      "text": "저는 이 흐름을 이렇게 봅니다. 지금은 그냥"
    },
    {
      "start": 57.558,
      "end": 60.653,
      "text": "집값이 오르느냐 내리느냐를 보는 구간이"
    },
    {
      "start": 60.653,
      "end": 63.749,
      "text": "아닙니다. 자산시장에서 돈의 목적지가"
    },
    {
      "start": 63.749,
      "end": 66.844,
      "text": "바뀌는 구간입니다. 주식에서 수익을 낸"
    },
    {
      "start": 66.844,
      "end": 70.303,
      "text": "사람이 다음 안전판을 찾고, 대출 규제가 강한"
    },
    {
      "start": 70.303,
      "end": 73.398,
      "text": "고가 주택 시장에서는 결국 현금 비중이 큰"
    },
    {
      "start": 73.398,
      "end": 76.676,
      "text": "사람이 움직입니다. 이때 돈은 아무 곳으로"
    },
    {
      "start": 76.676,
      "end": 79.771,
      "text": "가지 않습니다. 거래가 되고, 희소성이"
    },
    {
      "start": 79.771,
      "end": 83.23,
      "text": "있고, 다음 이야기가 있는 곳으로 가거든요."
    },
    {
      "start": 83.23,
      "end": 86.669,
      "text": "지금 화면에 나오는 이 부분을 보시면 핵심이"
    },
    {
      "start": 86.669,
      "end": 90.108,
      "text": "보입니다. 강남 3구와 용산은 고가 주택이"
    },
    {
      "start": 90.108,
      "end": 93.547,
      "text": "많아서 대출만으로 접근하기 어렵습니다."
    },
    {
      "start": 93.547,
      "end": 96.986,
      "text": "특히 25억 원을 넘는 아파트는 대출 한도가"
    },
    {
      "start": 96.986,
      "end": 100.233,
      "text": "작아지기 때문에, 주식이나 채권을 팔아"
    },
    {
      "start": 100.233,
      "end": 103.099,
      "text": "만든 현금이 실제 매입 자금으로 쓰일"
    },
    {
      "start": 103.099,
      "end": 106.347,
      "text": "가능성이 커집니다. 이 수치가 의미하는"
    },
    {
      "start": 106.347,
      "end": 109.404,
      "text": "것은 간단합니다. 강남 부동산은 대출"
    },
    {
      "start": 109.404,
      "end": 112.652,
      "text": "시장이 아니라 현금 시장에 더 가까워지고"
    },
    {
      "start": 112.652,
      "end": 113.989,
      "text": "있다는 겁니다."
    },
    {
      "start": 113.989,
      "end": 116.923,
      "text": "그럼 강남 3구 중에서도 어디가 가장"
    },
    {
      "start": 116.923,
      "end": 119.662,
      "text": "강할까요? 자료만 놓고 보면 답은"
    },
    {
      "start": 119.662,
      "end": 122.791,
      "text": "강남구입니다. 주식·채권 매각대금"
    },
    {
      "start": 122.791,
      "end": 125.725,
      "text": "유입액 기준으로 강남구가 송파구와"
    },
    {
      "start": 125.725,
      "end": 129.051,
      "text": "서초구보다 앞에 있습니다. 물론 송파와"
    },
    {
      "start": 129.051,
      "end": 132.572,
      "text": "서초도 강합니다. 하지만 자금 흐름, 업무"
    },
    {
      "start": 132.572,
      "end": 136.093,
      "text": "중심성, 개발 호재, 재건축 기대를 한 번에"
    },
    {
      "start": 136.093,
      "end": 139.418,
      "text": "겹쳐 보면 강남구의 밀도가 더 높습니다."
    },
    {
      "start": 139.418,
      "end": 142.939,
      "text": "투자 관점에서는 이 밀도가 중요하거든요."
    },
    {
      "start": 142.939,
      "end": 145.969,
      "text": "첫 번째 축은 삼성동입니다. 삼성역과"
    },
    {
      "start": 145.969,
      "end": 148.998,
      "text": "영동대로 일대는 강남의 판을 다시 짜는"
    },
    {
      "start": 148.998,
      "end": 152.596,
      "text": "구간입니다. 서울시 자료에 따르면 영동대로"
    },
    {
      "start": 152.596,
      "end": 155.247,
      "text": "지하공간 복합개발은 삼성역에서"
    },
    {
      "start": 155.247,
      "end": 158.655,
      "text": "봉은사역까지 이어지는 지하 5층, 17만"
    },
    {
      "start": 158.655,
      "end": 162.253,
      "text": "제곱미터 규모의 광역복합환승센터입니다."
    },
    {
      "start": 162.253,
      "end": 165.662,
      "text": "GTX-A와 GTX-C, 위례신사선,"
    },
    {
      "start": 165.662,
      "end": 168.502,
      "text": "2호선과 9호선이 한 축으로 묶이는"
    },
    {
      "start": 168.502,
      "end": 171.91,
      "text": "구조입니다. 교통망이 이렇게 겹치는 곳은"
    },
    {
      "start": 171.91,
      "end": 175.508,
      "text": "시간이 지날수록 중심성이 커질 수밖에 없죠."
    },
    {
      "start": 175.508,
      "end": 178.965,
      "text": "여기에 GBC가 붙습니다. 현대차 GBC는"
    },
    {
      "start": 178.965,
      "end": 182.24,
      "text": "49층 3개 동으로 조정됐고, 2031년"
    },
    {
      "start": 182.24,
      "end": 185.333,
      "text": "준공을 목표로 다시 움직이고 있습니다."
    },
    {
      "start": 185.333,
      "end": 188.79,
      "text": "공공기여 규모도 약 1조 9천827억 원으로"
    },
    {
      "start": 188.79,
      "end": 191.701,
      "text": "알려졌습니다. 중요한 건 건물 높이가"
    },
    {
      "start": 191.701,
      "end": 194.612,
      "text": "아닙니다. 오피스, 호텔, 전시장,"
    },
    {
      "start": 194.612,
      "end": 197.523,
      "text": "공연장, 도심숲, 지하 보행축이 같이"
    },
    {
      "start": 197.523,
      "end": 200.98,
      "text": "들어온다는 점입니다. 지금 화면에 보이는 이"
    },
    {
      "start": 200.98,
      "end": 204.073,
      "text": "구조를 보면, 삼성동은 단순한 업무지가"
    },
    {
      "start": 204.073,
      "end": 206.984,
      "text": "아니라 강남의 새로운 관문이 되는 쪽에"
    },
    {
      "start": 206.984,
      "end": 208.076,
      "text": "가깝습니다."
    },
    {
      "start": 208.076,
      "end": 211.35,
      "text": "두 번째 축은 압구정입니다. 압구정은 이미"
    },
    {
      "start": 211.35,
      "end": 214.079,
      "text": "비싼 동네라서 끝난 시장처럼 보일 수"
    },
    {
      "start": 214.079,
      "end": 217.353,
      "text": "있습니다. 그런데 진짜 포인트는 끝난 곳이"
    },
    {
      "start": 217.353,
      "end": 220.627,
      "text": "아니라 다시 설계되는 곳이라는 점입니다."
    },
    {
      "start": 220.627,
      "end": 223.901,
      "text": "서울시는 압구정 2구역부터 5구역까지를"
    },
    {
      "start": 223.901,
      "end": 226.993,
      "text": "신속통합기획으로 다루며, 한강변 수변"
    },
    {
      "start": 226.993,
      "end": 229.54,
      "text": "주거문화와 새로운 스카이라인을"
    },
    {
      "start": 229.54,
      "end": 232.814,
      "text": "제시했습니다. 최고 50층 내외, 약 1만"
    },
    {
      "start": 232.814,
      "end": 236.27,
      "text": "1천 세대 규모의 청사진이 언급됩니다. 이건"
    },
    {
      "start": 236.27,
      "end": 239.726,
      "text": "단지 하나의 재건축이 아니라 한강변 주거지의"
    },
    {
      "start": 239.726,
      "end": 242.454,
      "text": "체급을 다시 정하는 이야기입니다."
    },
    {
      "start": 242.454,
      "end": 245.496,
      "text": "세 번째 축은 대치와 개포입니다. 삼성동이"
    },
    {
      "start": 245.496,
      "end": 248.707,
      "text": "업무와 교통의 미래라면, 대치와 개포는 강남"
    },
    {
      "start": 248.707,
      "end": 251.918,
      "text": "주거 수요의 바닥을 받치는 축입니다. 대치는"
    },
    {
      "start": 251.918,
      "end": 255.298,
      "text": "학군이라는 아주 강한 수요 기반이 있고, 개포는"
    },
    {
      "start": 255.298,
      "end": 258.172,
      "text": "이미 재건축을 통해 주거 환경이 크게 바뀐"
    },
    {
      "start": 258.172,
      "end": 261.552,
      "text": "지역입니다. 여기에 남아 있는 노후 단지 정비와"
    },
    {
      "start": 261.552,
      "end": 264.932,
      "text": "브랜드 재건축 기대가 이어집니다. 부동산에서"
    },
    {
      "start": 264.932,
      "end": 267.974,
      "text": "가격을 밀어 올리는 힘은 하나가 아닙니다."
    },
    {
      "start": 267.974,
      "end": 271.354,
      "text": "교통, 일자리, 학군, 신축 희소성이 같이 겹칠"
    },
    {
      "start": 271.354,
      "end": 273.213,
      "text": "때 힘이 세지는 거거든요."
    },
    {
      "start": 273.213,
      "end": 276.468,
      "text": "그래서 저는 이번 흐름을 단순히 “주식 팔아 집"
    },
    {
      "start": 276.468,
      "end": 280.065,
      "text": "샀다”로 보지 않습니다. 더 정확히는 “유동성이"
    },
    {
      "start": 280.065,
      "end": 283.149,
      "text": "다시 서울 핵심 부동산을 확인하고 있다”로"
    },
    {
      "start": 283.149,
      "end": 286.403,
      "text": "봅니다. 주식이 많이 오르면 사람들은 수익을"
    },
    {
      "start": 286.403,
      "end": 289.829,
      "text": "실현합니다. 그런데 그 수익을 전부 다시 주식에"
    },
    {
      "start": 289.829,
      "end": 292.913,
      "text": "넣지는 않습니다. 일부는 더 오래 들고 갈 수"
    },
    {
      "start": 292.913,
      "end": 295.996,
      "text": "있는 실물 자산으로 옮깁니다. 한국에서 그"
    },
    {
      "start": 295.996,
      "end": 299.08,
      "text": "대표적인 목적지가 어디냐고 물으면, 결국"
    },
    {
      "start": 299.08,
      "end": 302.163,
      "text": "강남이라는 답이 반복해서 나오는 겁니다."
    },
    {
      "start": 302.163,
      "end": 305.534,
      "text": "물론 리스크도 있습니다. 금리, 세금,"
    },
    {
      "start": 305.534,
      "end": 309.103,
      "text": "대출 규제, 토지거래허가, 재건축 속도,"
    },
    {
      "start": 309.103,
      "end": 312.672,
      "text": "경기 둔화는 모두 변수입니다. 강남이라고"
    },
    {
      "start": 312.672,
      "end": 316.241,
      "text": "무조건 오르는 건 아닙니다. 특히 이미 비싼"
    },
    {
      "start": 316.241,
      "end": 319.215,
      "text": "자산은 진입 가격이 높기 때문에 잘못"
    },
    {
      "start": 319.215,
      "end": 321.991,
      "text": "들어가면 버티는 시간이 길어질 수"
    },
    {
      "start": 321.991,
      "end": 324.965,
      "text": "있습니다. 그래서 이 영상의 결론은"
    },
    {
      "start": 324.965,
      "end": 328.336,
      "text": "“아무거나 사라”가 아닙니다. 자료상"
    },
    {
      "start": 328.336,
      "end": 331.112,
      "text": "돈이 향하는 곳을 보라는 겁니다."
    },
    {
      "start": 331.112,
      "end": 334.204,
      "text": "정리하겠습니다. 지금 자금 흐름은 주식 수익이"
    },
    {
      "start": 334.204,
      "end": 336.987,
      "text": "부동산, 특히 서울 고가 주택으로 이동하는"
    },
    {
      "start": 336.987,
      "end": 340.079,
      "text": "장면을 보여주고 있습니다. 그중 강남구는 실제"
    },
    {
      "start": 340.079,
      "end": 343.171,
      "text": "유입액, 업무 중심성, 삼성역 개발, GBC,"
    },
    {
      "start": 343.171,
      "end": 345.953,
      "text": "압구정 재건축, 대치와 개포의 주거 수요가"
    },
    {
      "start": 345.953,
      "end": 348.891,
      "text": "겹칩니다. 앞으로 더 많은 사람이 주식을 팔고"
    },
    {
      "start": 348.891,
      "end": 351.983,
      "text": "부동산으로 갈아탄다면, 가장 먼저 봐야 할 곳은"
    },
    {
      "start": 351.983,
      "end": 354.766,
      "text": "강남입니다. 그리고 강남 안에서도 삼성,"
    },
    {
      "start": 354.766,
      "end": 357.703,
      "text": "압구정, 대치, 개포를 따로 보지 말고 하나의"
    },
    {
      "start": 357.703,
      "end": 360.795,
      "text": "큰 축으로 봐야 합니다. 결국 질문은 이겁니다."
    },
    {
      "start": 360.795,
      "end": 363.732,
      "text": "다음 돈의 목적지는 어디일까요? 저는 적어도"
    },
    {
      "start": 363.732,
      "end": 366.515,
      "text": "지금 자료만 놓고 보면, 그 답이 강남에 가장"
    },
    {
      "start": 366.515,
      "end": 369.452,
      "text": "가깝다고 봅니다. 다만 투자는 언제나 본인의"
    },
    {
      "start": 369.452,
      "end": 372.39,
      "text": "자금 계획과 리스크 감당 능력 안에서 판단해야"
    },
    {
      "start": 372.39,
      "end": 375.636,
      "text": "합니다. 방향은 강남입니다. 하지만 좋은 투자는"
    },
    {
      "start": 375.636,
      "end": 378.574,
      "text": "방향만 맞히는 게 아니라, 가격과 시간을 같이"
    },
    {
      "start": 378.574,
      "end": 379.965,
      "text": "맞히는 일이거든요."
    }
  ]
}
