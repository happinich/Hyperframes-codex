{
  "source": "scene-plan.json",
  "cues": [
    {
      "start": 0.0,
      "end": 2.973,
      "text": "앞으로 강남구가 더 좋아질"
    },
    {
      "start": 2.973,
      "end": 6.486,
      "text": "수밖에 없는 이유는 단순히 집값"
    },
    {
      "start": 6.486,
      "end": 9.73,
      "text": "이야기가 아닙니다. 핵심은"
    },
    {
      "start": 9.73,
      "end": 12.973,
      "text": "하나입니다. 이미 강한 도시"
    },
    {
      "start": 12.973,
      "end": 16.216,
      "text": "위에, 교통, 업무, 기술,"
    },
    {
      "start": 16.216,
      "end": 19.189,
      "text": "주거 인프라가 동시에 다시"
    },
    {
      "start": 19.189,
      "end": 22.162,
      "text": "깔리고 있다는 점입니다."
    },
    {
      "start": 22.162,
      "end": 24.865,
      "text": "강남은 지금부터 한 번 더"
    },
    {
      "start": 24.865,
      "end": 27.568,
      "text": "업그레이드되는 구간에"
    },
    {
      "start": 27.568,
      "end": 30.0,
      "text": "들어가고 있습니다."
    },
    {
      "start": 30.0,
      "end": 33.021,
      "text": "먼저 기본 체력입니다. 강남은"
    },
    {
      "start": 33.021,
      "end": 36.275,
      "text": "서울에서 경제 활동이 가장 밀집한"
    },
    {
      "start": 36.275,
      "end": 39.296,
      "text": "지역입니다. 2026년 기준"
    },
    {
      "start": 39.296,
      "end": 42.317,
      "text": "경제총조사 대상 사업체만 5만"
    },
    {
      "start": 42.317,
      "end": 45.57,
      "text": "4천여 곳으로 서울 자치구 중 최대"
    },
    {
      "start": 45.57,
      "end": 49.056,
      "text": "규모로 보도됐고, 2021년 기준"
    },
    {
      "start": 49.056,
      "end": 52.542,
      "text": "강남구 지역내총생산은 서울 전체의"
    },
    {
      "start": 52.542,
      "end": 55.796,
      "text": "16.5%를 차지했다는 자료도"
    },
    {
      "start": 55.796,
      "end": 59.049,
      "text": "있습니다. 이미 일자리와 소비,"
    },
    {
      "start": 59.049,
      "end": 61.838,
      "text": "서비스가 모여 있는 도시라는"
    },
    {
      "start": 61.838,
      "end": 63.0,
      "text": "뜻입니다."
    },
    {
      "start": 63.0,
      "end": 66.111,
      "text": "첫 번째 변화는 교통입니다."
    },
    {
      "start": 66.111,
      "end": 68.963,
      "text": "삼성역과 영동대로 일대는"
    },
    {
      "start": 68.963,
      "end": 72.074,
      "text": "앞으로 강남의 가장 큰 판이 될"
    },
    {
      "start": 72.074,
      "end": 74.148,
      "text": "가능성이 큽니다."
    },
    {
      "start": 74.148,
      "end": 77.0,
      "text": "GTX-A는 2026년"
    },
    {
      "start": 77.0,
      "end": 79.333,
      "text": "삼성역 무정차 통과,"
    },
    {
      "start": 79.333,
      "end": 82.444,
      "text": "2028년 완전 개통 계획이"
    },
    {
      "start": 82.444,
      "end": 85.815,
      "text": "언급되어 왔고, 삼성역 일대는"
    },
    {
      "start": 85.815,
      "end": 87.889,
      "text": "2호선, 9호선,"
    },
    {
      "start": 87.889,
      "end": 91.0,
      "text": "GTX-A, GTX-C,"
    },
    {
      "start": 91.0,
      "end": 94.37,
      "text": "위례신사선까지 겹치는 초대형"
    },
    {
      "start": 94.37,
      "end": 96.704,
      "text": "환승축으로 계획되어"
    },
    {
      "start": 96.704,
      "end": 98.0,
      "text": "있습니다."
    },
    {
      "start": 98.0,
      "end": 99.635,
      "text": "두 번째는 GBC와"
    },
    {
      "start": 99.635,
      "end": 102.906,
      "text": "국제교류복합지구입니다. 서울시는"
    },
    {
      "start": 102.906,
      "end": 105.564,
      "text": "2026년 1월 현대차 GBC"
    },
    {
      "start": 105.564,
      "end": 109.039,
      "text": "추가협상을 완료했고, 계획은 105층"
    },
    {
      "start": 109.039,
      "end": 111.696,
      "text": "1개 동에서 49층 3개 동으로"
    },
    {
      "start": 111.696,
      "end": 114.762,
      "text": "바뀌었습니다. 중요한 건 높이보다"
    },
    {
      "start": 114.762,
      "end": 117.829,
      "text": "역할입니다. 공공기여 총액은 1조"
    },
    {
      "start": 117.829,
      "end": 120.691,
      "text": "9,827억 원 규모로 늘었고,"
    },
    {
      "start": 120.691,
      "end": 123.552,
      "text": "영동대로 복합환승센터 같은 교통"
    },
    {
      "start": 123.552,
      "end": 126.619,
      "text": "인프라와 시민 공간에 투입됩니다."
    },
    {
      "start": 126.619,
      "end": 129.89,
      "text": "서울시는 2031년 말 준공을 목표로"
    },
    {
      "start": 129.89,
      "end": 132.751,
      "text": "글로벌 비즈니스와 문화 중심지를"
    },
    {
      "start": 132.751,
      "end": 135.0,
      "text": "만들겠다고 밝혔습니다."
    },
    {
      "start": 135.0,
      "end": 138.49,
      "text": "이 변화는 건물 하나로 끝나지 않습니다."
    },
    {
      "start": 138.49,
      "end": 141.57,
      "text": "국제교류복합지구 안에는 코엑스,"
    },
    {
      "start": 141.57,
      "end": 145.06,
      "text": "잠실, 탄천, 한강, 옛 한국감정원 부지"
    },
    {
      "start": 145.06,
      "end": 148.139,
      "text": "같은 주변 개발이 함께 묶입니다. 옛"
    },
    {
      "start": 148.139,
      "end": 151.219,
      "text": "한국감정원 부지 사전협상에서도 약"
    },
    {
      "start": 151.219,
      "end": 154.709,
      "text": "3,630억 원의 공공기여가 영동대로"
    },
    {
      "start": 154.709,
      "end": 157.788,
      "text": "지하공간 복합개발에 투입됩니다."
    },
    {
      "start": 157.788,
      "end": 161.278,
      "text": "강남의 미래는 점 하나가 아니라, 삼성과"
    },
    {
      "start": 161.278,
      "end": 164.563,
      "text": "코엑스, 잠실을 잇는 큰 면으로 바뀌는"
    },
    {
      "start": 164.563,
      "end": 166.0,
      "text": "이야기입니다."
    },
    {
      "start": 166.0,
      "end": 169.176,
      "text": "세 번째 이유는 기술입니다. 강남은"
    },
    {
      "start": 169.176,
      "end": 172.141,
      "text": "로봇과 AI를 실제 생활 현장에서"
    },
    {
      "start": 172.141,
      "end": 175.529,
      "text": "실험하는 도시로 움직이고 있습니다."
    },
    {
      "start": 175.529,
      "end": 178.282,
      "text": "강남구는 2026년 6월부터"
    },
    {
      "start": 178.282,
      "end": 181.671,
      "text": "민원창구, 주민센터, 버스정류장,"
    },
    {
      "start": 181.671,
      "end": 185.271,
      "text": "복지시설, 양재천 일대에서 생활밀착형"
    },
    {
      "start": 185.271,
      "end": 188.235,
      "text": "AI·디지털 실증을 시작한다고"
    },
    {
      "start": 188.235,
      "end": 191.835,
      "text": "발표했습니다. 8개 기업이 참여하고,"
    },
    {
      "start": 191.835,
      "end": 195.224,
      "text": "실시간 번역 민원창구, AI 홀로그램"
    },
    {
      "start": 195.224,
      "end": 198.612,
      "text": "안내, 전동휠체어 사고 감지, 스마트"
    },
    {
      "start": 198.612,
      "end": 202.0,
      "text": "전력관리 같은 서비스가 검증됩니다."
    },
    {
      "start": 202.0,
      "end": 205.6,
      "text": "기술을 쓰는 사람도 함께 키웁니다."
    },
    {
      "start": 205.6,
      "end": 208.72,
      "text": "강남구는 2026년에 청년과"
    },
    {
      "start": 208.72,
      "end": 211.6,
      "text": "특성화고생, 예비창업자 등"
    },
    {
      "start": 211.6,
      "end": 215.2,
      "text": "400명을 대상으로 AI·디지털"
    },
    {
      "start": 215.2,
      "end": 218.56,
      "text": "인재 양성 사업을 운영합니다. 또"
    },
    {
      "start": 218.56,
      "end": 221.92,
      "text": "구민 정보화교육 144개 과정 중"
    },
    {
      "start": 221.92,
      "end": 225.28,
      "text": "정규 강좌의 30% 이상을 생성형"
    },
    {
      "start": 225.28,
      "end": 228.4,
      "text": "AI 과정으로 편성했습니다."
    },
    {
      "start": 228.4,
      "end": 232.0,
      "text": "도시가 기술을 사오는 데서 끝나는 게"
    },
    {
      "start": 232.0,
      "end": 235.36,
      "text": "아니라, 주민과 기업이 같이 쓰는"
    },
    {
      "start": 235.36,
      "end": 238.0,
      "text": "방향으로 가고 있습니다."
    },
    {
      "start": 238.0,
      "end": 241.229,
      "text": "네 번째는 주거와 생활 환경입니다."
    },
    {
      "start": 241.229,
      "end": 243.597,
      "text": "강남구는 2025년 기준"
    },
    {
      "start": 243.597,
      "end": 246.396,
      "text": "95개소에서 정비사업이 진행"
    },
    {
      "start": 246.396,
      "end": 249.625,
      "text": "중이라고 밝혔고, 재건축드림지원"
    },
    {
      "start": 249.625,
      "end": 252.639,
      "text": "TF와 정비사업 교육을 통해 갈등"
    },
    {
      "start": 252.639,
      "end": 255.868,
      "text": "조정과 주민 이해를 돕고 있습니다."
    },
    {
      "start": 255.868,
      "end": 259.097,
      "text": "재건축은 시간이 오래 걸리고 변수도"
    },
    {
      "start": 259.097,
      "end": 262.111,
      "text": "많지만, 노후 주거지가 새 주거와"
    },
    {
      "start": 262.111,
      "end": 265.556,
      "text": "공공시설, 보행 환경, 녹지로 바뀌면"
    },
    {
      "start": 265.556,
      "end": 269.0,
      "text": "생활 품질은 다시 올라갈 수 있습니다."
    },
    {
      "start": 269.0,
      "end": 271.803,
      "text": "물론 모든 계획이 예정대로 간다는 보장은"
    },
    {
      "start": 271.803,
      "end": 275.266,
      "text": "없습니다. GTX 삼성역 공사, GBC 인허가,"
    },
    {
      "start": 275.266,
      "end": 278.564,
      "text": "위례신사선 추진, 재건축 속도에는 지연이 생길"
    },
    {
      "start": 278.564,
      "end": 281.532,
      "text": "수 있습니다. 그래서 이 영상은 투자 판단이"
    },
    {
      "start": 281.532,
      "end": 284.665,
      "text": "아니라 도시 변화의 방향을 보는 영상입니다."
    },
    {
      "start": 284.665,
      "end": 287.798,
      "text": "강남이 더 좋아질 가능성이 큰 이유는 이미 강한"
    },
    {
      "start": 287.798,
      "end": 290.931,
      "text": "입지에 새 교통망과 업무 중심지, 기술 실증,"
    },
    {
      "start": 290.931,
      "end": 294.064,
      "text": "주거 정비가 동시에 겹치고 있기 때문입니다."
    },
    {
      "start": 294.064,
      "end": 297.197,
      "text": "중요한 질문은 강남이 더 비싸질까가 아니라,"
    },
    {
      "start": 297.197,
      "end": 300.0,
      "text": "얼마나 더 입체적인 도시가 될까입니다."
    }
  ]
}
