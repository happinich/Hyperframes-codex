{
  "provider": "elevenlabs",
  "endpoint": "POST /v1/text-to-speech/:voice_id",
  "script_source": "../01_script/narration.txt",
  "target_audio": "inbox/2026-001-google-io-2026-narration.mp3",
  "auth": {
    "env_var": "ELEVENLABS_API_KEY",
    "do_not_commit_api_key": true
  },
  "request": {
    "voice_id": "syYMPZoPqpHXYytuWMFR",
    "model_id": "eleven_multilingual_v2",
    "language_code": "ko",
    "output_format": "mp3_44100_128",
    "voice_settings": {
      "stability": 0.55,
      "similarity_boost": 0.75,
      "style": 0.15,
      "use_speaker_boost": true
    }
  },
  "notes": [
    "voice_id와 필요 시 voice_settings는 사용자 확인 후 입력한다.",
    "텍스트는 narration.txt의 승인 원문만 사용한다.",
    "생성 후 scripts/ingest_audio.py와 scripts/align_captions.py로 정규화 및 Whisper large-v3 싱크를 진행한다."
  ]
}
