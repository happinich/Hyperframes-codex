  "cues": [
    {
      "start": 0.0,
      "end": 3.34,
      "text": "아무도 없는 볼풀에서 공이 날아왔어요. 키즈카페"
    },
    {
      "start": 3.34,
      "end": 5.92,
      "text": "마감을 끝내고, 빨간 공 하나를 안쪽으로"
    },
    {
      "start": 5.92,
      "end": 9.0,
      "text": "던졌거든요. 그런데 그 공이 제 발앞으로"
    },
    {
      "start": 9.0,
      "end": 12.12,
      "text": "돌아왔습니다. 밀대로 공을 전부 걷어 봤어요."
    },
    {
      "start": 12.68,
      "end": 15.8,
      "text": "아이는 없었어요. 그때 파란 바닥 매트가"
    },
    {
      "start": 15.8,
      "end": 18.9,
      "text": "안쪽에서 부풀었습니다. 제가 한 걸음 물러나자,"
    },
    {
      "start": 18.9,
      "end": 22.02,
      "text": "공들 아래에서도 똑같은 길이의 마찰음이 났어요."
    }
  ],
