{
  "schema_version": "1.6.0",
  "name": "hyperframes_longform_success_rules",
  "updated_from_project": "config/horror-channel-strategy.json",
  "purpose": "Horror-first reusable production rules for face-free HyperFrames long-form YouTube videos while preserving legacy explainer profiles.",
  "defaults": {
    "production_profile": {
      "catalog": "config/production-profiles.json",
      "preferred_profile_id": "horror_cinematic_story_v1",
      "legacy_profile_id": "classic_rich_motion_v1",
      "record_in_project_metadata": true
    },
    "format": {
      "primary": "youtube",
      "youtube": {
        "width": 1920,
        "height": 1080,
        "fps": 60,
        "aspect_ratio": "16:9"
      },
      "shorts_required_per_longform": true,
      "shorts_minimum_count": 1,
      "shorts": {
        "width": 1080,
        "height": 1920,
        "fps": 60,
        "aspect_ratio": "9:16",
        "duration_seconds_range": [15, 40],
        "composition": "separate_vertical_recomposition",
        "simple_center_crop_forbidden": true,
        "fresh_visual_assets_required": true,
        "reuse_longform_images_or_frames": false,
        "visual_provenance_check": "Generate new portrait assets for the Short; do not extract, crop, or reuse long-form images or video frames. Verify asset paths and hashes before delivery.",
        "source": "standalone spoiler-free cliffhanger rewrite based on the approved long-form story",
        "script_strategy": "start with a first-second hook, compress the threat escalation, and stop on a complete sentence immediately before the identity, twist, or ending is revealed",
        "reveal_longform_twist_or_ending": false,
        "raw_longform_excerpt_default": false,
        "separate_script_approval_required": true,
        "separate_tts_generation_required": true,
        "voice_speed": {
          "method": "quality-preserving postprocess after eleven_v3 generation",
          "default_multiplier": 1.07,
          "allowed_multiplier_range": [1.05, 1.1],
          "avoid_above": 1.1,
          "preserve_pitch": true,
          "manual_listening_review_required": true
        },
        "burned_captions_required": true,
        "external_srt_required": true,
        "external_vtt_required": true,
        "publishing_helper_required": true
      }
    },
    "visual_style": {
      "face_free": true,
      "approval_required_before_composition": true,
      "catalog": "config/visual-styles.json",
      "brightness": "selected_per_project",
      "palette": "selected_per_project",
      "allowed_style_ids": [
        "horror_cinematic",
        "minimal_dark_tech",
        "bright_editorial",
        "dark_cinematic",
        "contrast_split",
        "warm_documentary",
        "premium_finance",
        "neon_tech",
        "paper_collage",
        "adaptive_mix"
      ],
      "avoid": ["talking-head", "face close-up", "dark muddy background", "extended full-black frame", "unapproved burned-in captions"],
      "top_right_runtime_badge": false
    },
    "subtitles": {
      "delivery": "external_srt_upload",
      "burn_in_to_video": false,
      "generate_planned_captions_before_audio": true,
      "final_alignment_source": "mlx-community/whisper-large-v3-turbo",
      "post_review_captioned_version": {
        "enabled": true,
        "preserve_clean_master": true,
        "output_suffix": "-captioned-story",
        "position": "bottom-center-safe-area",
        "base_text_color": "white",
        "outline_color": "black",
        "active_word_color": null,
        "timing_source": "captions.words.json",
        "cue_mode": "semantic_phrase",
        "font_size_px": 44,
        "font_weight": 700,
        "outline_width_px": 6,
        "max_text_width_px": 1400,
        "max_glyphs_per_cue": 28
      },
      "profile_variants": {
        "horror_cinematic_story_v1": {
          "enabled": false,
          "delivery": "clean_master_plus_external_srt_vtt",
          "renderer": "scripts/burn_story_captions.mjs",
          "output_suffix": "-captioned-story",
          "position": "bottom-center-safe-area",
          "base_text_color": "white",
          "outline_color": "black",
          "active_word_color": null,
          "cue_mode": "semantic_phrase",
          "font_size_px": 44,
          "max_glyphs_per_cue": 28
        },
        "minimal_dark_tech_v1": {
          "renderer": "scripts/burn_story_captions.mjs",
          "output_suffix": "-captioned-story",
          "position": "bottom-center-safe-area",
          "base_text_color": "white",
          "outline_color": "black",
          "active_word_color": null,
          "cue_mode": "semantic_phrase",
          "font_size_px": 44,
          "max_glyphs_per_cue": 28
        },
        "classic_rich_motion_v1": {
          "renderer": "scripts/burn_story_captions.mjs",
          "output_suffix": "-captioned-story",
          "position": "bottom-center-safe-area",
          "base_text_color": "white",
          "outline_color": "black",
          "active_word_color": null,
          "cue_mode": "semantic_phrase",
          "font_size_px": 44,
          "max_glyphs_per_cue": 28
        }
      }
    }
  },
  "script_rules": {
    "active_channel_strategy": "config/horror-channel-strategy.json",
    "hook": {
      "first_3_seconds": "Start with a sharp question, core number, or reversal. Remove greetings and slow setup.",
      "horror_cold_open_seconds_range": [5, 10],
      "horror_first_anomaly_window_seconds": [40, 60],
      "examples": ["체크인한 사람은 다섯 명이었습니다. 그런데 CCTV에는 여섯 명이 찍혔습니다.", "새벽 세 시 십칠 분, 호출벨이 울려도 절대 받지 마십시오."]
    },
    "visual_cues": {
      "required_for_explainers": true,
      "forbidden_as_meta_narration_in_horror": true,
      "explainer_phrases": ["지금 화면에 나오는 이 부분을 보시면", "이 수치가 의미하는 것은", "여기서 중요한 건"]
    },
    "spoken_tension": {
      "style": "short conversational Korean",
      "sentence_length": "short and tight",
      "avoid": ["long written-style paragraphs", "slow greetings", "abstract setup without a visual anchor"]
    },
    "horror_story": {
      "format": "one complete 6-8 minute modern everyday-horror story per video",
      "preferred_devices": ["호출벨", "인터폰", "CCTV", "블랙박스", "택시 앱", "단체 채팅방"],
      "rotation_target_percent": {
        "explicit_ghost": 40,
        "creature_or_unknown_entity": 30,
        "modern_rule_horror": 20,
        "psychological_or_mystery_horror": 10
      },
      "maximum_consecutive_implicit_only_stories": 1,
      "opening": "Lead with the most disturbing line for 5-10 seconds, establish why the narrator is there and what normal looks like, then introduce the first anomaly between 40 and 60 seconds.",
      "narration_style": "Use natural polite spoken Korean storytelling, as if a person were recounting an experience directly to the listener. Mix endings such as ~했어요, ~였죠, ~거든요, ~더라고요, and occasional ~했습니다 according to emotion and pacing. Avoid chains of clipped 했다/였다 sentences and any mechanically repeated ending.",
      "explicit_entity_rule": "For ghost or creature stories, confirm that the entity exists through direct interaction by the late story. Reveal it as trace, partial form, then clear interaction without repeatedly showing a full face or explaining its complete origin.",
      "anthology_default": false,
      "ending": "Leave a concrete residual rule, sound, time, object, or viewer-directed implication instead of explaining everything.",
      "truth_label_required": true,
      "default_truth_label": "fiction",
      "voice_casting_review": {
        "required_with_script_review": true,
        "recommendation_options": ["male", "female"],
        "evaluate": [
          "protagonist identity and point of view",
          "narrator distance and emotional intensity",
          "contrast between narration and entity dialogue",
          "pace and escalation required by the script"
        ],
        "include": [
          "primary recommendation with reason",
          "secondary option with tradeoff",
          "whether the narrator gender must match the protagonist"
        ],
        "selection_requires_separate_approval": true
      }
    },
    "scene_plan": {
      "one_scene_one_claim": true,
      "caption_text_equals_narration_text": true,
      "required_fields": [
        "id",
        "type",
        "start_seconds",
        "end_seconds",
        "duration_seconds",
        "purpose",
        "narration_text",
        "caption_text",
        "visual",
        "motion",
        "motion_beats",
        "audio",
        "transition_out",
        "shorts_adaptation"
      ]
    }
  },
  "audio_rules": {
    "elevenlabs": {
      "model_id": "eleven_v3",
      "apply_text_normalization": "on",
      "text_sources": {
        "display_and_captions": "01_script/narration.txt",
        "tts_pronunciation": "01_script/tts-narration.txt",
        "expand_korean_numbers_before_tts": true,
        "reject_remaining_digits_in_tts_source": true
      },
      "voice_settings": {
        "stability": 0.5,
        "similarity_boost": 0.75,
        "style": 0.15,
        "use_speaker_boost": true
      },
      "chunking": {
        "enabled": true,
        "target_chars_min": 1000,
        "target_chars_max": 1300,
        "split_on": [".", "?", "!", "\n", "다.", "요."],
        "avoid_sentence_mid_cut": true
      },
      "merge_chunks_sequentially": true
    },
    "bgm": {
      "enabled": true,
      "loop_to_voice_length": true,
      "voice_ducking_gain_db": -18,
      "allowed_gain_db_range": [-20, -15],
      "outro_delay_seconds": 4,
      "fade_out_seconds": 3,
      "cut_bgm_at_voice_plus_outro": true
    },
    "horror_sound_design": {
      "strategy_source": "config/horror-channel-strategy.json",
      "layers": ["narration", "room_ambience", "event_foley", "approved_bgm"],
      "intentional_silence_seconds_range": [0.35, 1.2],
      "mark_intentional_silence_in_scene_plan": true,
      "manual_review_threshold_seconds": 0.8,
      "avoid_unapproved_jump_scare_peaks": true
    },
    "pacing_review": {
      "whisper_model": "mlx-community/whisper-large-v3-turbo",
      "long_silence_threshold_seconds": 0.8,
      "long_word_gap_threshold_seconds": 0.8,
      "target_average_wpm_source": "production_profile",
      "target_average_wpm_range": [95, 135],
      "profile_ranges": {
        "horror_cinematic_story_v1": [110, 140],
        "minimal_dark_tech_v1": [145, 165],
        "classic_rich_motion_v1": [95, 135]
      }
    }
  },
  "sync_rules": {
    "source_of_truth": "whisper_word_timings_after_final_audio",
    "planned_scene_times_are_draft_only": true,
    "after_audio_generation": [
      "Run Whisper alignment.",
      "Recalculate scene start/end from actual word timings.",
      "Update composition scene times.",
      "Update scene-plan.json so planning matches the rendered video."
    ],
    "screen_timing": {
      "scene_visual_lead_seconds": 0.35,
      "visual_reveal_delay_seconds_max": 0.35,
      "title_reveal_delay_seconds_max": 0.1,
      "subtitle_reveal_delay_seconds_max": 0.25
    },
    "quality_gates": {
      "caption_match_ratio_min": 0.92,
      "freeze_detect_threshold": {
        "noise_db": -55,
        "duration_seconds": 3
      },
      "black_detect_threshold_seconds": 1,
      "metadata_duration_match_tolerance_seconds": 0.1,
      "manual_frame_checks": [
        "first scene transition",
        "data/table scene",
        "hub/axis scene",
        "final conclusion scene"
      ]
    }
  },
  "motion_rules": {
    "minimum_activity": "No static explanatory screen longer than 3 seconds.",
    "background_motion": ["slow sheen", "moving grid", "subtle orb", "deep zoom", "focus shift", "light flicker", "fog", "scanline", "shadow movement"],
    "horror_visuals": {
      "reference_sheet_required": ["character", "location", "period", "palette", "lighting", "recurring_object", "threat_entity_when_present"],
      "preferred": ["clue close-up", "empty corridor", "door gap", "CCTV frame", "phone interface", "rainy night road", "consistent ghost or creature interaction in the mid-to-late reveal"],
      "entity_reveal_stages": ["trace", "partial silhouette or body detail", "clear physical interaction"],
      "narrator_face_free_does_not_forbid_entity_visibility": true,
      "avoid": ["repeated ghost-face close-up", "unmotivated early full-body creature reveal", "gore as the primary hook", "unreadable darkness", "full black over 1 second"]
    },
    "data_visuals": {
      "bars": ["pulse fill", "spark/marker movement", "value highlight"],
      "tables": ["row reveal", "moving marker", "highlight sweep"],
      "hub_diagrams": ["connector draw", "node drift", "hub pulse"],
      "maps": ["pin reveal", "region glow", "slow pan"]
    },
    "title_fit": {
      "dynamic_font_class_by_korean_length": true,
      "compact_title_min_chars": 15,
      "long_title_min_chars": 20,
      "avoid_single_character_orphan_lines": true
    },
    "timeline_safety": {
      "do_not_extend_total_duration_with_repeats": true,
      "verify_discovered_duration_before_full_render": true,
      "target_discovered_duration_source": "audio_or_last_scene_end"
    }
  },
  "render_rules": {
    "commands": [
      "npm run hf:lint -- <project>/04_composition",
      "python3 scripts/render_project.py <project> --format youtube --dry-run",
      "python3 scripts/render_project.py <project> --format youtube",
      "python3 scripts/render_project.py <project> --format shorts --dry-run",
      "python3 scripts/render_project.py <project> --format shorts"
    ],
    "verify": [
      "ffprobe duration, streams, resolution, fps",
      "ffmpeg freezedetect=n=-55dB:d=4",
      "extract review frames around scene transitions",
      "manually inspect text fit and visual readiness",
      "render a captioned derivative only when the selected production profile and project brief explicitly enable it"
    ],
    "known_non_blocking_warnings": [
      "composition_file_too_large can be accepted for urgent iteration, but refactor later"
    ]
  },
  "publishing_rules": {
    "youtube_publish_md_single_file": true,
    "include_copy_buttons": true,
    "description_must_include": ["summary", "timestamps", "content_nature_label", "playlist_or_related_video", "hashtags"],
    "horror_channel_strategy": "config/horror-channel-strategy.json",
    "shorts_related_video_required": true,
    "shorts_publish_package_required": true,
    "shorts_publish_package_path": "07_publish/shorts/shorts-publish.html",
    "shorts_description_urls_are_not_treated_as_clickable_cta": true,
    "horror_short_must_not_reveal_longform_twist_or_ending": true,
    "longform_end_screen_seconds_range": [15, 20],
    "tags": {
      "comma_separated": true,
      "target_chars_max": 450
    },
    "thumbnail": {
      "count_min": 2,
      "style": "provocative but readable",
      "required": ["large Korean hook text", "single focal clue", "strong mobile contrast"],
      "avoid": ["faces", "logos", "tiny text", "misspelled Korean", "watermark"],
      "profile_variants": {
        "horror_cinematic_story_v1": {
          "text_korean_syllables_range": [4, 8],
          "required": ["decisive clue", "warning red accent", "title-complementing phrase"],
          "avoid": ["ghost face repetition", "gore", "complex collage", "title text duplicated verbatim"]
        },
        "classic_rich_motion_v1": {
          "required_for_finance_topics": ["core number", "visual money flow", "topic destination"]
        }
      }
    }
  }
}
